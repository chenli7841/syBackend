@using System.Linq
@model EplusCore.Models.LoginViewModel
@inject Microsoft.ApplicationInsights.AspNetCore.JavaScriptSnippet JavaScriptSnippet

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <title>登录 - 舒誉后台管理系统</title>
    <link rel="shortcut icon" href="~/images/favicon.png" />
    @Html.Raw(JavaScriptSnippet.FullScript)
    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Microsoft YaHei", sans-serif;
            font-size: 14px;
            color: #505050;
            background-color: #f2f4f4;
            background-image: url('@Url.Content("~/images/shuyu-login-bg.png")');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 40px 6vw;
        }

        .login-brand {
            position: fixed;
            top: 32px;
            left: 40px;
        }

            .login-brand img {
                height: 56px;
            }

        .login-card {
            width: 100%;
            max-width: 440px;
            background-color: #ffffff;
            border-radius: 1rem;
            box-shadow: 0 12px 40px rgba(62, 85, 120, 0.12);
            padding: 3rem;
        }

        .login-title {
            font-size: 26px;
            font-weight: 700;
            color: #2b2b2b;
            margin: 0 0 0.5rem;
            text-align: left;
        }

        .login-subtitle {
            font-size: 15px;
            color: #8a8a8a;
            margin: 0 0 2rem;
            text-align: left;
        }

        .login-error {
            color: #F44336;
            font-size: 14px;
            margin-bottom: 1rem;
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        .login-input {
            width: 100%;
            height: 48px;
            padding: 0 16px;
            font-size: 15px;
            color: #333;
            background-color: #fff;
            border: 1px solid #e1e1e1;
            border-radius: 0.5rem;
            outline: none;
            transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
        }

            .login-input:focus {
                border-color: #5D4CE5;
                box-shadow: 0 0 0 3px rgba(93, 76, 229, 0.12);
            }

        .login-submit {
            width: 100%;
            height: 56px;
            margin-top: 0.75rem;
            font-size: 18px;
            font-weight: 600;
            color: #fff;
            background-color: #5D4CE5;
            border: none;
            border-radius: 0.5rem;
            cursor: pointer;
            transition: background-color .15s ease-in-out;
        }

            .login-submit:hover {
                background-color: #7B6AF0;
            }

            .login-submit:active {
                background-color: #4B3BD1;
            }

        .login-footer {
            margin-top: 2rem;
            text-align: center;
            color: #b0b0b0;
            font-size: 12px;
        }

        @@media (max-width: 768px) {
            .login-page {
                display: block;
                min-height: auto;
                padding: 24px;
            }

            .login-brand {
                position: static;
                display: flex;
                justify-content: center;
                margin-bottom: 24px;
            }

            .login-card {
                width: auto;
                max-width: none;
                margin: 0;
                padding: 2rem;
            }
        }
    </style>
</head>
<body>
    <div class="login-brand">
        <img src="~/images/shuyu-logo.png" alt="舒誉 SHUYU" />
    </div>
    <div class="login-page">
        <div class="login-card">
            @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, true, new { role = "form", data_entersubmit = "yes" }))
            {
                <h1 class="login-title">登录舒誉后台</h1>
                <p class="login-subtitle">请输入账号密码，进入管理系统</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-error">
                        @foreach (var error in ViewData.ModelState.Where(m => string.IsNullOrEmpty(m.Key)).SelectMany(m => m.Value.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <div class="form-group">
                    @Html.TextBoxFor(m => m.UserName, new { @class = "login-input", @placeholder = "用户名", @required = "", @autofocus = "" })
                </div>
                <div class="form-group">
                    @Html.PasswordFor(m => m.Password, new { @class = "login-input", @placeholder = "密码", @required = "" })
                </div>
                <button type="submit" class="login-submit">登录</button>

                <div class="login-footer">
                    舒心所托 誉达全球
                </div>
            }
        </div>
    </div>
</body>
</html>
