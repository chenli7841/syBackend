@using Domain.Entities
@using Domain.Enums
@using Domain.Models.Extensions
@using Microsoft.AspNetCore.Mvc.Rendering
@model Domain.Entities.PackageBatchEntity

@{
    ViewData["Title"] = "创建批次";
}

@section Styles
    {
    <link rel="stylesheet" href="~/vendors/jquery-toast-plugin/jquery.toast.min.css">
    <style>
        #totalShippingCostBtn {
            border: none;
            background: transparent;
            color: #6200EE;
            padding-left: 0;
            cursor: pointer;
        }

        #totalShippingCostModal td:nth-child(2) {
            padding: 5px 20px;
        }

        #totalShippingCostModal td:nth-child(3) {
            text-align: right;
            padding: 5px 20px;
        }
    </style>
}

@{
    var recipients = (IEnumerable<UserEntity>)ViewBag.Recipients;
    var agents = (IEnumerable<UserEntity>)ViewBag.Agents;
    var pickuplocations = ((IEnumerable<PickUpLocationEntity>)ViewBag.PickUpLocations).ToList();
    var masterBatches = ((IEnumerable<BatchEntity>)ViewBag.MasterBatches).ToList();
    var companies = ((IEnumerable<CompanyEntity>)ViewBag.Companies).ToList();
    var routes = ((IEnumerable<RouteEntity>)ViewBag.Routes).ToList();
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">创建批次 装箱打包</h4>
                @using (Html.BeginForm("SavePackageBatch", "Batch", FormMethod.Post, new { @class = "" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.TextBoxFor(b => b.Id, new { hidden = "hidden" })
                    @Html.TextBoxFor(b => b.GroupType, new { hidden = "hidden" })
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.CustomName, "名称", new { @class = "col-sm-2 col-form-label" })
                                <div class="col-sm-10">
                                    <div class="input-group">
                                        @Html.TextBoxFor(r => r.CustomName, new { hidden = "hidden" })
                                        @Html.TextBoxFor(r => r.Name, new { hidden = "hidden" })
                                        <input type="text" class="form-control" id="custom-name" />
                                        <span class="input-group-text" id="formatted-name"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group row">
                                <label class="col-sm-2 col-form-label" for="destination-select">目的地</label>
                                <div class="col-sm-10">
                                    <select class="form-control" id="destination-select">
                                        <option value="toronto">Toronto</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="company-select">公司</label>
                                @Html.TextBoxFor(b => b.CompanyId, new { hidden = "hidden" })
                                <div class="col-sm-8">
                                    <select class="form-control" id="company-select">
                                        @{
                                            for (int i = 0; i < companies.Count; i++)
                                            {
                                                var c = companies[i];
                                                <option value="@c.Id">@c.Name</option>
                                            }
                                        }

                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="route-select">线路</label>
                                @Html.TextBoxFor(b => b.RouteId, new { hidden = "hidden" })
                                <div class="col-sm-8">
                                    <select class="form-control" id="route-select">
                                        @{
                                            for (int i = 0; i < routes.Count; i++)
                                            {
                                                var r = routes[i];
                                                <option value="@r.Id">@r.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div style="display: none;" id="recipient-input" class="form-group row">
                                @Html.LabelFor(r => r.RecipientId, "客户", new { @class = "col-sm-4 col-form-label" })
                                @Html.TextBoxFor(b => b.RecipientId, new { hidden = "hidden" })
                                <div class="col-sm-8">
                                    <input type="text" id="recipientSearch" class="form-control" data-toggle="dropdown" data-bs-auto-close="inside" />
                                    <ul class="dropdown-menu" style="width: 100%" id="searched-recipient-options">
                                    </ul>
                                </div>
                            </div>
                            <div style="display: none;" id="pick-up-location-input" class="form-group row">
                                <label class="col-sm-4 col-form-label" for="pick-up-location-select">取货点</label>
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(b => b.PickUpLocationId, new { hidden = "hidden" })
                                    <select class="form-control" id="pick-up-location-select">
                                        @{
                                            for (int i = 0; i < pickuplocations.Count; i++)
                                            {
                                                var p = pickuplocations[i];
                                                <option value="@p.Id">@p.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="master-batch-select">装车发货批次</label>
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(b => b.MasterBatchId, new { hidden = "hidden" })
                                    <select class="form-control" id="master-batch-select">
                                        @{
                                            for (int i = 0; i < masterBatches.Count; i++)
                                            {
                                                var b = masterBatches[i];
                                                <option value="@b.Id">@b.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.TargetWeightKg, "目标重量", new { @class = "col-sm-1 col-form-label" })
                                <div class="col-sm-11">
                                    @Html.TextBoxFor(r => r.TargetWeightKg, "{0:0.00}", new { @class = "form-control", type = "number", step = "0.01" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.Note, "备注", new { @class = "col-form-label" })
                                @Html.TextAreaFor(r => r.Note, new { @class = "form-control" })
                            </div>
                        </div>
                    </div>


                    <div class="row" style="gap: 20px;">
                        <div>
                            <button type="submit" class="btn btn-success">保存</button>
                        </div>                        
                    </div>
                }

                @if (Model.Id > 0)
                {
                    <div class="form-group row mt-4">
                        <label class="col-form-label col-1">从批次:</label>
                        <input class="form-control col-3" id="targetBatch" />
                        <button class="btn btn-primary ml-3" id="merge">合并</button>
                    </div>
                }

                @if (Model.Id > 0)
                {
                    <div class="table-responsive">
                        <table id="box-listing" class="table table-striped">
                            <thead>
                                <tr>
                                    <th>箱号</th>
                                    <th>总单数</th>
                                    <th>总重量</th>
                                    <th>编号</th>
                                    <th>打印</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var box in Model.Boxes.OrderBy(b => b.Number))
                                {
                                    <tr>
                                        <td>@Html.ActionLink(box.Number.ToString(), "EditBox", new { boxId = box.Id })</td>
                                        <td>@box.Orders.Count()</td>
                                        <td>@box.Orders.Sum(o => o.WeightKg)</td>
                                        <td>@Model.Id - @box.Number</td>
                                        <td><a href='@Url.Action("PrintBatchBox")?id=@box.Id' target="_blank"><i class="fa fa-print fa-lg"></i></a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @Html.ActionLink("添加", "AddBox", null, new { id = Model.Id, boxNumber = Model.Boxes.Count + 1 }, new { @class = "btn btn-primary" })

                    <h5 class="mt-2">其他单</h5>
                    <div class="row">
                        @foreach (var otherOrder in Model.OtherOrders)
                        {
                            <div class="col-2">@otherOrder</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="totalShippingCostModal" tabindex="-1" role="dialog" aria-labelledby="totalShippingCostModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <p>运费 = 物品运费 + 实收关税 + 超长费用 + 熏蒸费用 + 仓库费用 + 港杂费 + 保险金额</p>
                <p>注意：不包括仓储费 和 地区附加费</p>
                <table>
                    <tbody>
                        <tr><td></td><td>物品运费总计</td><td id='totalItemCostText'></td></tr>
                        <tr><td></td><td>实收关税总计</td><td id='totalDutyText'></td></tr>
                        <tr><td></td><td>超长费用总计</td><td id='totalOversizeCostText'></td></tr>
                        <tr><td></td><td>熏蒸费用总计</td><td id='totalFumigationCostText'></td></tr>
                        <tr><td></td><td>仓库费用总计</td><td id='totalWarehouseCostText'></td></tr>
                        <tr><td></td><td>港杂费总计</td><td id='totalPortMisCostText'></td></tr>
                        <tr><td>+</td><td>保险金额总计</td><td id='totalInsuranceText'></td></tr>
                        <tr style='border-bottom: 1px black solid'><td>-</td><td>总折扣</td><td id='totalDiscountText'></td></tr>
                        <tr><td></td><td style='padding-bottom: 30px'>总运费</td><td id='totalShippingCostText' style='padding-bottom: 30px'></td></tr>
                        <tr><td></td><td>仓储费总计</td><td id='totalStorageCostText'></td></tr>
                        <tr><td></td><td>地区附加费总计</td><td id='totalDistrictAdditionalCostText'></td></tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" id="totalShippingCost-cancel-btn" class="btn btn-light" data-dismiss="modal">关闭</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
    {
    <script src="~/vendors/jquery-toast-plugin/jquery.toast.min.js"></script>
    <script>
        let global_routes = @Html.Raw(Json.Serialize(ViewBag.Routes));
        let global_companies = @Html.Raw(Json.Serialize(ViewBag.Companies));
        let global_pick_up_locations = @Html.Raw(Json.Serialize(ViewBag.PickUpLocations));
        let global_master_batch = @Html.Raw(Json.Serialize(ViewBag.MasterBatches));
        let global_companyIds = global_companies[0].id, routeIds = '', global_selected_user_code = '';
        let search = document.location.search;
        if (search.includes("?")) {
            search = search.replace("?", "");
            let companyPart = search.split("&").find(p => p.split("=")[0].toLowerCase() === "companyids");
            if (companyPart) global_companyIds = companyPart.split("=")[1];
            let routePart = search.split("&").find(p => p.split("=")[0].toLowerCase() === "routeid");
            if (!routePart) routeIds = "";
            else routeIds = routePart.split("=")[1];
        }
        $('#recipientSearch').on('focusout', function() {
            let recipientCode = $('#recipientSearch').val();
            if (recipientCode.trim() === '') return;
            $.get(`@Url.Action("SearchByUserCode", "User")?code=${recipientCode}&pageSize=10&companyIds=${global_companyIds}`,
                {},
                function (result) {
                    document.getElementById("site-overlay").style.display = "none";

                    if (result.error && result.error.text) {
                        $.toast({
                            heading: result.error.text,
                            position: 'mid-center',
                            icon: 'error'
                        });
                    } else {
                        let searchUserHTML = '';
                        for (const user of result.data) {
                            searchUserHTML += `<li class="dropdown-item" onclick="onSelectRecipient(${user.id}, '${user.orderStartNumber}', '${user.orderStartNumber} - ${user.userName}')">${user.orderStartNumber} - ${user.userName}</li>`;
                        }
                        $('#searched-recipient-options').html(searchUserHTML);
                    }
                });
        });
        function onSelectRecipient(userId, userCode, displayName) {
            global_selected_user_code = userCode;
            $('#recipientSearch').val(displayName);
            $('#RecipientId').val(userId);
            updateFormattedName();
        }
        $('#agent-select').val($('#AgentId').val());

        $('#agent-select').change(function () {
            $('#AgentId').val(this.value);
        });

        $('#master-batch-select').val($('#MasterBatchId').val());

        $('#master-batch-select').change(function () {
            $('#MasterBatchId').val(this.value);
        });

        $('#stage-select').val($('#Stage').val());

        $('#stage-select').change(function () {
            $('#Stage').val(this.value);
        });


        $('#batch_edit_split_by_locations_btn').click(function () {
            fetch('/batch/SplitByLocations/' + @Model.Id)
                .then(async response => {
                    if (response.status === 400) {
                        const body = await response.json();
                        if (!body.value.error) {
                            $.toast({
                                heading: '未知错误',
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        } else {
                            $.toast({
                                heading: body.value.error.text,
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        }
                    }
                    else if (response.status === 200) {
                        $.toast({
                            heading: '拆分成功',
                            position: 'mid-center',
                            icon: 'success'
                        });
                    }
                });
            return false;
        });

        $('#batch_edit_split_by_agents_btn').click(function () {
            fetch('/batch/SplitByAgents/' + @Model.Id)
                .then(async response => {
                    if (response.status === 400) {
                        const body = await response.json();
                        if (!body.value.error) {
                            $.toast({
                                heading: '未知错误',
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        } else {
                            $.toast({
                                heading: body.value.error.text,
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        }
                    }
                    else if (response.status === 200) {
                        $.toast({
                            heading: '拆分成功',
                            position: 'mid-center',
                            icon: 'success'
                        });
                    }
                });
            return false;
        });

        $('#batch_edit_split_by_recipients_btn').click(function () {
            fetch('/batch/SplitByRecipients/' + @Model.Id)
                .then(async response => {
                    if (response.status === 400) {
                        const body = await response.json();
                        if (!body.value.error) {
                            $.toast({
                                heading: '未知错误',
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        } else {
                            $.toast({
                                heading: body.value.error.text,
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        }
                    }
                    else if (response.status === 200) {
                        $.toast({
                            heading: '拆分成功',
                            position: 'mid-center',
                            icon: 'success'
                        });
                    }
                });
            return false;
        });

        $('#batch_edit_split_warehouse_cost_btn').click(function () {
            fetch('/batch/SplitByNonAgent/' + @Model.Id)
                .then(async response => {
                    if (response.status === 400) {
                        const body = await response.json();
                        if (!body.value.error) {
                            $.toast({
                                heading: '未知错误',
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        } else {
                            $.toast({
                                heading: body.value.error.text,
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        }
                    }
                    else if (response.status === 200) {
                        $.toast({
                            heading: '拆分成功',
                            position: 'mid-center',
                            icon: 'success'
                        });
                    }
                });
            return false;
        });

        $('#batch_edit_split_bill_btn').click(function () {
            fetch('/batch/SplitByNonLocation/' + @Model.Id)
                .then(async response => {
                    if (response.status === 400) {
                        const body = await response.json();
                        if (!body.value.error) {
                            $.toast({
                                heading: '未知错误',
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        } else {
                            $.toast({
                                heading: body.value.error.text,
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        }
                    }
                    else if (response.status === 200) {
                        $.toast({
                            heading: '拆分成功',
                            position: 'mid-center',
                            icon: 'success'
                        });
                    }
                });
            return false;
        });

        $('#batch_edit_update_order_load_delivery_properties_btn').click(function () {
            fetch('/batch/UpdateLoadDeliveryProperties/' + @Model.Id)
                .then(async response => {
                    if (response.status === 400) {
                        const body = await response.json();
                        if (!body.value.error) {
                            $.toast({
                                heading: '未知错误',
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        } else {
                            $.toast({
                                heading: body.value.error.text,
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        }
                    }
                    else if (response.status === 200) {
                        $.toast({
                            heading: '批次名更新成功',
                            position: 'mid-center',
                            icon: 'success'
                        });
                    }
                });
            return false;
        });

        $('#box-listing').DataTable({
            paging: false,
            searching: false,
            info: false,
            order: [],
            language: {
                search: "搜索:",
            },
        });

        $('#batch-action').click(function () {
            document.getElementById("site-overlay").style.display = "block";
        });
        $('#companyId').val(global_companyIds);
        $('#company-select').val(global_companyIds);
        $('#company-select').change(function () {
            document.location = `${document.location.origin}${document.location.pathname}?groupType=Package&companyIds=${$('#company-select').val()}`;
        });
        function onSelectRoute(routeId) {
            let r = global_routes.find(r => r.id === routeId);
            if (!r) return;
            if (r.type === @((int)RouteType.Mixed)) {
                $('#recipient-input').hide();
                $('#pick-up-location-input').show();
            } else if (r.type === @((int)RouteType.Direct)) {
                $('#recipient-input').show();
                $('#pick-up-location-input').hide();
            }
        }
        function updateFormattedName() {
            let companyId = parseInt($('#company-select').val());
            let companyCode = global_companies.find(c => c.id === companyId).code;
            let routeId = parseInt($('#route-select').val());
            let route = global_routes.find(r => r.id === routeId);
            if (route.type === @((int)RouteType.Mixed)) {
                let locationId = parseInt($('#pick-up-location-select').val());
                let locationName = global_pick_up_locations.find(l => l.id === locationId).name;
                $('#formatted-name').text(`${companyCode}-${route.code}-${locationName}-装箱打包`);
            } else if (route.type === @((int)RouteType.Direct)) {
                if (global_selected_user_code.toString().trim() === '') {
                    $('#formatted-name').text(`${companyCode}-${route.code}-装箱打包`);
                } else {
                    $('#formatted-name').text(`${companyCode}-${route.code}-${global_selected_user_code}-装箱打包`);
                }
            }
            $('#Name').val(`${$('#custom-name').val()}-${$('#formatted-name').text()}`);
        }
        $('#custom-name').change(function() {
            $('#Name').val(`${$('#custom-name').val()}-${$('#formatted-name').text()}`);
            $('#CustomName').val(`${$('#custom-name').val()}`);
        });
        $('#route-select').change(function () {
            let routeId = parseInt($('#route-select').val());
            $('#routeId').val(routeId);
            let r = global_routes.find(r => r.id === routeId);
            if (!r) return;
            if (r.type === @((int)RouteType.Mixed)) {
                $('#recipient-input').hide();
                $('#pick-up-location-input').show();
            } else if (r.type === @((int)RouteType.Direct)) {
                $('#recipient-input').show();
                $('#pick-up-location-input').hide();
            }
            updateFormattedName();
        });
        $('#pick-up-location-select').change(function () {
            $('#PickUpLocationId').val($('#pick-up-location-select').val());
            updateFormattedName();
        });
        onSelectRoute(global_routes[0].id);

        $('#merge').click(function () {
            const sourceBatchAndBox = $('#targetBatch').val();
            const targetBatchId = @Model.Id;
            if (sourceBatchAndBox === '') {
                alert('请填写从批次');
                return false;
            }

            document.getElementById("site-overlay").style.display = "block";
            const sourceBatchId = sourceBatchAndBox.split('-')[0].trim();
            const sourceBoxNumber = (sourceBatchAndBox.split('-')[1] || '').trim();

            $.post('@Url.Action("Merge")',
                {
                    targetBatchId,
                    sourceBatchId,
                    sourceBoxNumber
                },
                function (result) {
                    document.getElementById("site-overlay").style.display = "none";

                    if (result.error && result.error.text) {
                        $.toast({
                            heading: result.error.text,
                            position: 'mid-center',
                            icon: 'error'
                        });
                    } else {
                        $.toast({
                            heading: '合并成功',
                            position: 'mid-center',
                            icon: 'success'
                        });

                        setTimeout(() => { window.location.reload(); }, 2 * 1000);
                    }
                });
        });

        $(document).ready(() => {
            fetch('/batch/GetOrderCostSummary?batchId=' + @Model.Id)
                .then(async response => {
                    const body = await response.json();
                    if (response.status === 400) {
                        if (!body.value.error) {
                            $.toast({
                                heading: '未知错误',
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        } else {
                            $.toast({
                                heading: body.value.error.text,
                                hideAfter: false,
                                position: 'mid-center',
                                icon: 'error'
                            });
                        }
                    }
                    else if (response.status === 200) {
                        $('#totalItemCostText').text(body.data.totalItemCost.toFixed(2));
                        $('#totalDutyText').text(body.data.totalDuty.toFixed(2));
                        $('#totalOversizeCostText').text(body.data.totalOversizeCost.toFixed(2));
                        $('#totalFumigationCostText').text(body.data.totalFumigationCost.toFixed(2));
                        $('#totalWarehouseCostText').text(body.data.totalWarehouseCost.toFixed(2));
                        $('#totalPortMisCostText').text(body.data.totalPortMisCost.toFixed(2));
                        $('#totalInsuranceText').text(body.data.totalInsurance.toFixed(2));
                        $('#totalDiscountText').text(body.data.totalDiscount.toFixed(2));
                        const totalShippingCost =
                            body.data.totalItemCost +
                            body.data.totalDuty +
                            body.data.totalOversizeCost +
                            body.data.totalFumigationCost +
                            body.data.totalWarehouseCost +
                            body.data.totalPortMisCost +
                            body.data.totalInsurance -
                            body.data.totalDiscount;
                        $('#totalShippingCostText').text(totalShippingCost.toFixed(2));
                        $('#totalStorageCostText').text(body.data.totalStorageCost.toFixed(2));
                        $('#totalDistrictAdditionalCostText').text(body.data.totalDistrictAdditionalCost.toFixed(2));

                        $('#TotalShippingCost').val(totalShippingCost.toFixed(2));
                        $('#TotalOversizeCost').val(body.data.totalDistrictAdditionalCost.toFixed(2))
                        $('#TotalStorageCost').val(body.data.totalStorageCost.toFixed(2))
                    }
                });
        })
    </script>
}