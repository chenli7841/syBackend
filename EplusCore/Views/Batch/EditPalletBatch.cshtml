@using Domain.Entities
@using Domain.Enums
@using Domain.Models.Extensions
@using Microsoft.AspNetCore.Mvc.Rendering
@model Domain.Entities.PalletBatchEntity

@{
    ViewData["Title"] = "批次详情";
}

@section Styles
{
    <link rel="stylesheet" href="~/vendors/jquery-toast-plugin/jquery.toast.min.css">
    <style>
        #totalShippingCostBtn {
            border: none;
            background: transparent;
            color: #6200EE;
            padding-left: 0;
            cursor: pointer;
        }

        .link {
            color: #007bff;
            border: none;
            background: transparent;
        }
    </style>
}

@{
    var masterBatches = ((IEnumerable<BatchEntity>)ViewBag.MasterBatches).ToList();
    var routes = ((IEnumerable<RouteEntity>)ViewBag.Routes).ToList();
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">修改批次 开托盘</h4>
                @using (Html.BeginForm("SavePalletBatch", "Batch", FormMethod.Post, new { @class = "" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.TextBoxFor(b => b.Id, new { hidden = "hidden" })
                    @Html.TextBoxFor(b => b.GroupType, new { hidden = "hidden" })

                    <div class="row">
                        <div class="col-md-1">
                            <label class="col-form-label">基础信息</label>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.Name, "名称", new { @class = "col-sm-2 col-form-label" })
                                <div class="col-sm-10">
                                    <div class="input-group">
                                        @Html.TextBoxFor(r => r.Name, new { hidden = "hidden" })
                                        @Html.TextBoxFor(r => r.CustomName, new { @class = "form-control" })
                                        <span class="input-group-text" id="formatted-name"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-1">
                            <label class="col-form-label">位置信息</label>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.MasterBatchId, "装车发货", new { @class = "col-sm-4 col-form-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(r => r.MasterBatchId, new { hidden = "hidden" })
                                    <select class="form-control" id="master-batch-select">
                                        @{
                                            for (int i = 0; i < masterBatches.Count; i++)
                                            {
                                                var b = masterBatches[i];
                                                <option value="@b.Id">@b.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.ShipFlightNumber, "船号", new { @class = "col-sm-4 col-form-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(r => r.ShipFlightNumber, new { @class = "form-control", disabled = true })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.LoadDeliveryStage, "批次状态", new { @class = "col-sm-4 col-form-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(r => r.LoadDeliveryStage, new { @class = "form-control", disabled = true })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-1 col-md-1">
                            <label class="col-form-label">基础数据</label>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.TotalOrders, "总单数", new { @class = "col-sm-6 col-form-label" })
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(r => r.TotalOrders, new { @class = "form-control", disabled = true })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.TotalWeightKg, "总重量", new { @class = "col-sm-6 col-form-label" })
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(r => r.TotalWeightKg, new { @class = "form-control", disabled = true })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.TotalVolume, "总体积", new { @class = "col-sm-6 col-form-label" })
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(r => r.TotalVolume, new { @class = "form-control", disabled = true })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.Boxes.Count, "总箱数", new { @class = "col-sm-6 col-form-label" })
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(r => r.Boxes.Count, new { @class = "form-control", disabled = true })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.TotalChargedWeightKg, "总收费重量", new { @class = "col-sm-6 col-form-label" })
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(r => r.TotalChargedWeightKg, new { @class = "form-control", disabled = true })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.Length, "长", new { @class = "col-sm-4 col-form-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(r => r.Length, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.Width, "宽", new { @class = "col-sm-4 col-form-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(r => r.Width, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.Height, "高", new { @class = "col-sm-4 col-form-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(r => r.Height, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.WeightKg, "重量", new { @class = "col-sm-4 col-form-label" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(r => r.WeightKg, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.Note, "仓库备注", new { @class = "col-sm-1 col-form-label" })
                                @Html.TextAreaFor(r => r.Note, new { @class = "col-sm-11 form-control" })
                            </div>
                        </div>
                    </div>

                    <div class="row" style="gap: 20px;">
                        <div>
                            <button type="submit" class="btn btn-success">保存</button>
                        </div>
                        @*@if (Model.Id > 0)
                    {
                    <div class="col-md-1">
                    <button class="btn btn-primary" id="send-message">发消息</button>
                    </div>
                    }*@
                    </div>
                }

                @if (Model.Id > 0)
                {
                    <div class="form-group row mt-4">
                        <label class="col-form-label col-1">从批次:</label>
                        <input class="form-control col-3" id="targetBatch" />
                        <button class="btn btn-primary ml-3" id="merge">合并</button>
                        <button class="btn btn-primary ml-3" id="acceptBox">加入包裹</button>
                        <button class="btn btn-primary ml-3" id="acceptOrder">加入运单</button>
                    </div>
                }

                @if (Model.Id > 0)
                {
                    <div class="table-responsive">
                        <table id="box-listing" class="table table-striped">
                            <thead>
                                <tr>
                                    <th>箱号</th>
                                    <th>总单数</th>
                                    <th>包裹总重量(kg)</th>
                                    <th>标签号</th>
                                    <th>打印</th>
                                    <th>保存</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var box in Model.Boxes.OrderBy(b => b.Number))
                                {
                                    <tr>
                                        <td>@Html.ActionLink((string.IsNullOrWhiteSpace(box.Name) ? ($"{box.BatchId} - {box.Number}") : box.Name), "PackageEditBox", new { boxId = box.Id })</td>
                                        <td>@box.Orders.Count()</td>
                                        <td>@box.Orders.Sum(o => o.WeightKg)</td>
                                        <td>@box.OriginalObjectNumber</td>
                                        <td><a href='@Url.Action("PrintBatchBox")?id=@box.Id' target="_blank"><i class="fa fa-print fa-lg"></i></a></td>
                                        <td><button class="link" onclick="UpdateBatchBox(@box.Id)"><i class="fa fa-save fa-lg"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/vendors/jquery-toast-plugin/jquery.toast.min.js"></script>
    <script>
        let global_routes = @Html.Raw(Json.Serialize(ViewBag.Routes));
        let global_master_batch = @Html.Raw(Json.Serialize(ViewBag.MasterBatches));
        function UpdateBatchBox(batchBoxId) {
            let length = parseFloat($(`#length_${batchBoxId}_input`).val()) || undefined;
            let width = parseFloat($(`#width_${batchBoxId}_input`).val()) || undefined;
            let height = parseFloat($(`#height_${batchBoxId}_input`).val()) || undefined;
            let actualWeightKg = parseFloat($(`#actualWeight_${batchBoxId}_input`).val()) || undefined;
            $.post('@Url.Action("UpdateBatchBox")',
                {
                    boxId: batchBoxId,
                    length, width, height, actualWeightKg,
                },
                function (result) {
                    if (result.error) {
                        $.toast({
                            heading: result.error.text,
                            position: 'mid-center',
                            icon: 'error'
                        });
                    } else {
                        $.toast({
                            heading: 'Success',
                            text: '操作成功',
                            showHideTransition: 'slide',
                            icon: 'success',
                            loaderBg: '#f2a654',
                            position: 'mid-center'
                        });
                    }
                }
            );
        }

        function updateFormattedName() {
            let companyCode = '@Model.CompanyCode';
            let masterBatchId = parseInt($('#master-batch-select').val());
            let destinationName = 'toronto';
            if (!$('#master-batch-select').val()) {
                $('#formatted-name').text(`${companyCode}-${destinationName}-托盘`);
                updateName();
                return;
            }
            let masterBatchName = global_master_batch.find(b => b.id === masterBatchId).name;
            $('#formatted-name').text(`${companyCode}-${masterBatchName}-${destinationName}-托盘`);
            updateName();
        }

        function updateName() {
            $('#Name').val(`${$('#CustomName').val()}-${$('#formatted-name').text()}`);
        }

        $('#CustomName').change(function() {
            updateName();
        });

        $('#master-batch-select').val($('#MasterBatchId').val());

        $('#master-batch-select').change(function () {
            $('#MasterBatchId').val(this.value);
        });

        $('#update-to-dispatched').click(function () {
            $('#TransportStatus').val("dispatched");
        });

        $('#update-to-paid').click(function () {
            $('#PaymentStatus').val("paid");
        });

        $('#merge').click(function () {
            const sourceBatchAndBox = $('#targetBatch').val();
            const targetBatchId = @Model.Id;
            if (sourceBatchAndBox === '') {
                alert('请填写从批次');
                return false;
            }

            document.getElementById("site-overlay").style.display = "block";
            const sourceBatchId = sourceBatchAndBox.split('-')[0].trim();
            const sourceBoxNumber = (sourceBatchAndBox.split('-')[1] || '').trim();

            $.post('@Url.Action("Merge")',
                {
                    targetBatchId,
                    sourceBatchId,
                    sourceBoxNumber,
                    originalBoxNumber: sourceBatchAndBox
                },
                function (result) {
                    document.getElementById("site-overlay").style.display = "none";

                    if (result.error && result.error.text) {
                        $.toast({
                            heading: result.error.text,
                            position: 'mid-center',
                            icon: 'error'
                        });
                    } else {
                        $.toast({
                            heading: '合并成功',
                            position: 'mid-center',
                            icon: 'success'
                        });

                        setTimeout(() => { window.location.reload(); }, 2 * 1000);
                    }
                });
        });

        $('#acceptBox').click(function () {
            const sourceBatchAndBox = $('#targetBatch').val();
            const targetBatchId = @Model.Id;
            if (sourceBatchAndBox === '') {
                alert('请填写从批次');
                return false;
            }

            document.getElementById("site-overlay").style.display = "block";
            const sourceBatchId = sourceBatchAndBox.split('-')[0].trim();
            const sourceBoxNumber = (sourceBatchAndBox.split('-')[1] || '').trim();

            $.post('@Url.Action("AcceptBox")',
                {
                    targetBatchId,
                    sourceBatchId,
                    sourceBoxNumber,
                    originalBoxNumber: sourceBatchAndBox
                },
                function (result) {
                    document.getElementById("site-overlay").style.display = "none";

                    if (result.error && result.error.text) {
                        $.toast({
                            heading: result.error.text,
                            position: 'mid-center',
                            icon: 'error'
                        });
                    } else {
                        $.toast({
                            heading: '合并成功',
                            position: 'mid-center',
                            icon: 'success'
                        });

                        setTimeout(() => { window.location.reload(); }, 2 * 1000);
                    }
                });
        });

        $('#acceptOrder').click(function () {
            const sourceOrderNumberOrDomesticNumber = $('#targetBatch').val().trim();
            const targetBatchId = @Model.Id;
            if (sourceOrderNumberOrDomesticNumber === '') {
                alert('请填写运单号或国内单号');
                return false;
            }

            document.getElementById("site-overlay").style.display = "block";

            $.post('@Url.Action("AcceptOrderToPallet")',
                {
                    targetBatchId,
                    orderOrDomesticNumber: sourceOrderNumberOrDomesticNumber,
                },
                function (result) {
                    document.getElementById("site-overlay").style.display = "none";

                    if (result.error && result.error.text) {
                        $.toast({
                            heading: result.error.text,
                            position: 'mid-center',
                            icon: 'error'
                        });
                    } else {
                        $.toast({
                            heading: '添加运单成功',
                            position: 'mid-center',
                            icon: 'success'
                        });

                        setTimeout(() => { window.location.reload(); }, 2 * 1000);
                    }
                });
        });




        $(document).ready(() => {
            updateFormattedName();
        })
    </script>
}