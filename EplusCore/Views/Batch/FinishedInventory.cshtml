@using Domain.Enums
@using Domain.Models.Extensions
@model WebUI.Models.BatchInventoryResponse

@{
    ViewData["Title"] = "已完成";
}

@section Styles
{
    <link rel="stylesheet" href="~/vendors/select2/select2.min.css">
    <link rel="stylesheet" href="~/vendors/jquery-toast-plugin/jquery.toast.min.css">
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body" id="order-details">
                @await Component.InvokeAsync("BatchInfo", null)
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <div class="row" style="margin: 0; margin-bottom: 12px; gap: 20px; align-items: center;">
                    <h4 class="card-title" style="margin-bottom: 0">@Model.GroupType.GetDescription()</h4>
                    <div style="display: flex; gap: 4px; height: 32px; flex: 1;">
                        <select class="form-control" id="company-select">
                            @{
                                var companies = Model.Companies.ToList();
                                for (int i = 0; i < companies.Count; i++)
                                {
                                    var c = companies[i];
                                    <option value="@c.Id">@c.Name</option>
                                    if (i == companies.Count - 1)
                                    {
                                        var allCompanyIds = string.Join(",", companies.Select(c => c.Id));
                                        <option value="@allCompanyIds">All</option>
                                    }
                                }
                            }

                        </select>
                    </div>
                    <div style="display: flex; gap: 4px; height: 32px; flex: 1;">
                        <select class="form-control" id="route-select">
                            @{
                                var routes = Model.Routes.ToList();
                                for (int i = 0; i < routes.Count; i++)
                                {
                                    var c = routes[i];
                                    <option value="@c.Id">@c.Name</option>
                                    if (i == routes.Count - 1)
                                    {
                                        var allRouteIds = string.Join(",", routes.Select(c => c.Id));
                                        <option value="@allRouteIds">All</option>
                                    }
                                }
                            }

                        </select>
                    </div>
                </div>
                <div class="tab-content tab-content-solid">
                    <div class="tab-pane fade show active" id="home-5-1" role="tabpanel" aria-labelledby="tab-5-1">
                        <div class="table-responsive">
                            <table id="batch-listing" class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>名称</th>
                                        <th>创建日期</th>
                                        <th>总单数</th>
                                        <th>总重量</th>
                                        <th>总费用</th>
                                        <th>详情</th>
                                        <th>导出</th>
                                    </tr>
                                </thead>
                            </table>

                            <div id="batch-listing-goto-page" style="display: flex; align-items: center; justify-content: flex-end; gap: 8px; margin-top: 8px;">
                                <span>跳转到</span>
                                <input type="number" id="batch-listing-goto-page-input" class="form-control form-control-sm" min="1" step="1" style="width: 70px;" />
                                <span>页 / 共 <span id="batch-listing-total-pages">1</span> 页</span>
                                <button id="batch-listing-goto-page-btn" class="btn btn-sm btn-primary">跳转</button>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="profile-5-2" role="tabpanel" aria-labelledby="tab-5-2"> Lorem ipsum dolor sit amet, consectetur adipisicing elit. Deleniti eveniet, sapiente corrupti, vitae excepturi nulla soluta esse in ex, dignissimos velit rerum maiores asperiores! </div>
                    <div class="tab-pane fade" id="contact-5-3" role="tabpanel" aria-labelledby="tab-5-3"> Lorem ipsum dolor sit amet, consectetur adipisicing elit. Ullam officia mollitia repudiandae, tempore provident omnis magnam deleniti obcaecati, non atque asperiores maiores sint! Officiis rerum quaerat perferendis adipisci aut pariatur. </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/vendors/jquery-toast-plugin/jquery.toast.min.js"></script>
    <script src="~/vendors/select2/select2.min.js"></script>
    <script>
        $(document).ready(() => {
            const groupType = '@Model.GroupType';
            const routeId = '@Model.SelectedRouteId';
            const warehouseId = '@Model.SelectedWarehouseId';
            $.fn.dataTable.ext.errMode = (e) => {
                const body = e.jqXHR.responseJSON;
                if (body.error) {
                    $.toast({
                        heading: body.error.name,
                        text: body.error.text,
                        showHideTransition: 'slide',
                        icon: 'error',
                        loaderBg: '#f2a654',
                        position: 'mid-center',
                        hideAfter: 20000,
                    });
                }
                console.log(a.jqXHR.responseJSON);
            }

            const batchTable = $('#batch-listing').DataTable({
                "processing": true, // for show progress bar
                "serverSide": true, // for process server side
                "filter": false, // this is for disable filter (search box)
                "orderMulti": false, // for disable multiple column at once
                "ordering": false,
                "lengthChange": false, // for show entries dropdown
                "searchPanes": true,
                "ajax": {
                    "url":
                        '@Html.Raw(Url.Action("LoadData", new { groupType = Model.GroupType, routeId = Model.SelectedRouteId, recipientUserId = Model.SelectedRecipientUserId, belongsToUserId = Model.SelectedBelongsToUserId, warehouseId = Model.SelectedWarehouseId, companyIds = Model.CompanyIds }))',
                    "type": "POST",
                    "datatype": "json"
                },
                "columnDefs": [
                    { "targets": [0], "visible": false, "searchable": false },
                ],
                "columns": [
                    { "data": "id", "autoWidth": true },
                    {
                        "name": "name",
                        "autoWidth": true,
                        "render": (data, type, row) => `<a href='#' onclick=loadBatchDetails(${row.id}); >${row.name
                            }</a>`
                    },
                    { "data": "dateCreatedDisplay", "autoWidth": true },
                    { "data": "totalOrders", "autoWidth": true },
                    { "data": "totalWeightKg", "autoWidth": true },
                    { "data": "totalShippingCost", "autoWidth": true },
                    {
                        "render": (data, type, full, meta) => `<a href='@Url.Action("Edit")?id=${full.id
                            }'><i class="fa fa-edit fa-lg"></i></a>`
                    },
                    { "render": (data, type, full, meta) => `<a href='@Url.Action("Export")?id=${full.id}' target="_blank"><i class="fa fa-table fa-lg"></i></a>` },
                ],
                "language": {
                    // https://datatables.net/manual/i18n
                    "processing": "处理中...",
                    "info": "显示 _TOTAL_ 里面的_START_ 到 _END_",
                    "paginate": {
                        "previous": "前一页",
                        "next": "下一页"
                    },
                },
                "drawCallback": function() {
                    const pageInfo = batchTable.page.info();
                    const totalPages = pageInfo.pages || 1;
                    $('#batch-listing-total-pages').text(totalPages);
                    $('#batch-listing-goto-page-input').attr('max', totalPages);
                    $('#batch-listing-goto-page-input').val(pageInfo.page + 1);
                },
            });

            function goToBatchListingPage() {
                const pageInfo = batchTable.page.info();
                const totalPages = pageInfo.pages || 1;
                const input = $('#batch-listing-goto-page-input');
                const requestedPage = parseInt(input.val(), 10);

                if (!requestedPage || requestedPage < 1 || requestedPage > totalPages) {
                    $.toast({
                        heading: 'Danger',
                        text: `请输入 1 到 ${totalPages} 之间的页码`,
                        showHideTransition: 'slide',
                        icon: 'error',
                        loaderBg: '#f2a654',
                        position: 'mid-center',
                        hideAfter: 2000,
                    });
                    input.val(pageInfo.page + 1);
                    return;
                }

                batchTable.page(requestedPage - 1).draw('page');
            }

            $('#batch-listing-goto-page-btn').click(function() {
                goToBatchListingPage();
            });

            $('#batch-listing-goto-page-input').on('keyup', function(event) {
                if (event.key === 'Enter') {
                    goToBatchListingPage();
                }
            });

            let companyIds = '', routeIds = '';
            let search = document.location.search;
            if (search.includes("?")) {
                search = search.replace("?", "");
                let companyPart = search.split("&").find(p => p.split("=")[0].toLowerCase() === "companyids");
                if (!companyPart) companyIds = "";
                else companyIds = companyPart.split("=")[1];
                let routePart = search.split("&").find(p => p.split("=")[0].toLowerCase() === "routeid");
                if (!routePart) routeIds = "";
                else routeIds = routePart.split("=")[1];
            }
            $('#company-select').val(companyIds);
            $('#company-select').change(function () {
                document.location = `${document.location.origin}${document.location.pathname}?companyIds=${$('#company-select').val()}`;
            });
            $('#route-select').val(routeIds);
            $('#route-select').change(function () {
                document.location = `${document.location.origin}${document.location.pathname}?companyIds=${$('#company-select').val()}&routeId=${$('#route-select').val()}`;
            });

            let users = @Html.Raw(Json.Serialize(Model.Users));
            users = users.map(u => {
                return {
                    id: u.id,
                    text: u.name + " - " + u.orderStartNumber,
                    pickUpLocationId: u.selectedPickUpLocationId
                }
            });
            $('#recipient-select').select2({ data: users });
            $('.select2-selection').css('height', '32px');
            $('#select2-recipient-select-container').css('height', '32px');
            $('.select2-container--default .select2-selection--single .select2-selection__arrow').css('top', '4px');
            let agents = @Html.Raw(Json.Serialize(Model.Users.Where(u => u.Role == RoleType.Advanced)));
            agents = agents.map(u => {
                return {
                    id: u.id,
                    text: u.name + " - " + u.orderStartNumber,
                    pickUpLocationId: u.selectedPickUpLocationId
                }
            });
            $('#agent-select').select2({ data: agents });
            $('.select2-selection').css('height', '32px');
            $('#select2-agent-select-container').css('height', '32px');
            $('.select2-container--default .select2-selection--single .select2-selection__arrow').css('top', '4px');

            let params = window.location.search.split('recipientUserId=');
            if (params.length === 2) {
                let currentRecipientUserId = params[1].split('&')[0];
                $('#recipient-select').val(currentRecipientUserId).trigger('change');
            }
            params = window.location.search.split('belongsToUserId=');
            if (params.length === 2) {
                let currentBelongsToUserId = params[1].split('&')[0];
                $('#agent-select').val(currentBelongsToUserId).trigger('change');
            }

            $('#batch_inventory_search_btn').click(() => {
                let location = `/Batch/Inventory?groupType=${groupType}`
                if (routeId && routeId.trim() !== '') {
                    location = location + `&routeId=${routeId}`;
                }
                if (warehouseId && warehouseId.trim() !== '') {
                    location = location + `&warehouseId=${warehouseId}`;
                }
                const recipientUserId = $('#recipient-select').val();
                if (recipientUserId && recipientUserId.trim() !== '') {
                    location = location + `&recipientUserId=${recipientUserId}`;
                }
                const belongsToUserId = $('#agent-select').val();
                if (belongsToUserId && belongsToUserId.trim() !== '') {
                    location = location + `&belongsToUserId=${belongsToUserId}`;
                }
                window.location.href = location;
            });
        });

        function loadBatchDetails(id) {
            $.ajax({
                url: '@Url.Action("QuickView", "Batch")',
                data: { id },
                success: data => $('#order-details').html(data)
            });
        }

        (function displayBatchCount() {
            const needToDisplayCount =
                '@(Model.GroupType != BatchGroupType.DailyScan && Model.GroupType != BatchGroupType.DailyReturn)' ===
                'True';

            if (!needToDisplayCount) {
                return;
            }

            $.ajax({
                url: '@Url.Action("GetBatchCountByRoute", "Batch")',
                data: { groupType: '@Model.GroupType' },
                success: function (result) {
                    if (result.data) {
                        result.data.forEach(element => {
                            const routeHeader = $(`#route${element.routeId}`);
                            routeHeader.find('i').remove();
                            routeHeader.text(routeHeader.text().replace('()', `(${element.batchCount})`));
                        });
                    }
                }
            });
        })();
    </script>
}