@model WebUI.Models.OrderInventoryResponse

@{
    ViewData["Title"] = "其他单";
}

@section Styles
{
    <style>
        div.card .order-card-body, #order-details {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }

        #order-listing_wrapper div#order-listing_filter {
            display: none;
        }

            #order-listing_wrapper div#order-listing_filter input {
                width: 600px;
            }
    </style>
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="card">
            <div class="card-body order-card-body">
                <div class="row">
                    <h4 class="card-title col-3">搜索</h4>
                    <div class="col-9">
                        <select class="form-control" id="company-select">
                            @{
                                var companies = Model.Companies.ToList();
                                for (int i = 0; i < companies.Count; i++)
                                {
                                    var c = companies[i];
                                    <option value="@c.Id">@c.Name</option>
                                    if (i == companies.Count - 1)
                                    {
                                        var allCompanyIds = string.Join(",", companies.Select(c => c.Id));
                                        <option value="@allCompanyIds">All</option>
                                    }
                                }
                            }

                        </select>
                    </div>
                </div>
                <div class="table-responsive">
                    <table id='otherorder-listing-search' class="table table-striped">
                        <thead>
                            <tr>
                                <th data-searchable="true">单号</th>
                                <th>所属批次</th>
                                <th>创建时间</th>
                                <th>操作员</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(document).ready(() => {
            const tableId = 'otherorder-listing-search';
            $(`#${tableId} thead tr`).clone(true).appendTo(`#${tableId} thead`);
            $(`#${tableId} thead tr:eq(1) th`).each(function(i) {
                if (!$(this).data('searchable')) {
                    $(this).html('');
                    return;
                }

                const title = $(this).text();
                $(this).css('padding-left', '0');
                $(this).html('<input type="text" class="form-control form-control-sm" placeholder="搜索 ' + title + '" />');

                $('input', this).on('keyup change',
                    function(event) {
                        if (event.key !== 'Enter') {
                            return;
                        }

                        if (orderTable.column(i).search() !== this.value) {
                            orderTable.column(i).search(this.value).draw();
                        }
                    });
            });

            var dataTableOptions = {
                "processing": true, // for show progress bar
                "serverSide": true, // for process server side
                "filter": true, // this is for disable filter (search box)
                "orderMulti": false, // for disable multiple column at once
                "ordering": false,
                "stateSave": false,
                "lengthChange": false, // for show entries dropdown
                "ajax": {
                    "url": '@Html.Raw(Url.Action("LoadOtherOrder", new {companyIds = Model.CompanyIds}))',
                    "type": "POST",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "otherOrder", "name": "OtherOrder", "autoWidth": true },
                    { "render": (data, type, full, meta) => `<a href='@Url.Action("Edit")?id=${full.batchId}'>${full.batchName}</a>` },
                    { "data": "dateCreated", "name": "DateCreated", "autoWidth": true },
                    { "render": (data, type, full, meta) => {
                        if (full.creator) {
                            return full.creator.userName;
                        } else {
                            return '';
                        }
                    } },
                ],
                "language": {
                    // https://datatables.net/manual/i18n
                    "processing": "处理中...",
                    search: "_INPUT_",
                    searchPlaceholder: "搜索...",
                    "info": "显示 _TOTAL_ 里面的_START_ 到 _END_",
                    "paginate": {
                        "previous": "前一页",
                        "next": "下一页"
                    },
                },
            };

            const orderTable = $(`#${tableId}`).DataTable(dataTableOptions);
            $("input[type='search']").closest('div.row').hide();

            let companyIds = '';
            let search = document.location.search;
            if (search.includes("?")) {
                search = search.replace("?", "");
                let part = search.split("&").find(p => p.split("=")[0].toLowerCase() === "companyids");
                if (!part) companyIds = "";
                else companyIds = part.split("=")[1];
            }
            $('#company-select').val(companyIds);
            $('#company-select').change(function () {
                document.location = `${document.location.origin}${document.location.pathname}?companyIds=${$('#company-select').val()}`;
            });
        });
    </script>
}