@{
    ViewData["Title"] = "短信失败记录";
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="card">
            <div class="card-body order-card-body">
                <div class="table-responsive">
                    <table id="smslog-listing" class="table table-striped">
                        <thead>
                            <tr><th>内容</th><th>收信人电话</th><th>发信人代码</th><th>错误</th><th>尝试次数</th></tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(document).ready(() => {
            console.log("init sms log table");
            const smslogTable = $('#smslog-listing').DataTable({
                "processing": true, // for show progress bar
                "serverSide": true, // for process server side
                "filter": false, // this is for disable filter (search box)
                "orderMulti": false, // for disable multiple column at once
                "ordering": false,
                "stateSave": false,
                "lengthChange": false, // for show entries dropdown
                "ajax": {
                    "url": '@Url.Action("LoadSmsLogs")',
                    "type": "POST",
                    "datatype": "json"
                },
                "columnDefs": [],
                "columns": [
                    { "data": "content", "name": "Content", "autoWidth": true },
                    { "data": "recipientPhoneNumber", "name": "RecipientPhoneNumber", "autoWidth": true },
                    { "data": "senderOrderStartNumber", "name": "SenderOrderStartNumber", "autoWidth": true },
                    { "data": "errorSummary", "name": "ErrorSummary", "autoWidth": true },
                    { "data": "attempts", "name": "Attempts", "autoWidth": true }
                ],
                "language": {
                    // https://datatables.net/manual/i18n
                    "processing": "处理中...",
                    search: "_INPUT_",
                    searchPlaceholder: "搜索...",
                    "info": "显示 _TOTAL_ 里面的_START_ 到 _END_",
                    "paginate": {
                        "previous": "前一页",
                        "next": "下一页"
                    },
                },
            });
        })
    </script>
}