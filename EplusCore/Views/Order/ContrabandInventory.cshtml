@using Domain.Models.Extensions
@using Domain.Enums
@model WebUI.Models.OrderInventoryResponse

@{
    ViewData["Title"] = "违禁品";
}

@section Styles
    {
    <link rel="stylesheet" href="~/vendors/jquery-toast-plugin/jquery.toast.min.css">
    <style>
        div.card .order-card-body, #order-details {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }

        #order-listing_wrapper div#order-listing_filter {
            display: none;
        }

            #order-listing_wrapper div#order-listing_filter input {
                width: 600px;
            }
    </style>
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body" id="order-details">
                @await Component.InvokeAsync("OrderInfo", null)
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="card">
            <div class="card-body order-card-body">
                <h4 class="card-title">@Model.OrderState.GetDescription()</h4>
                <div class="table-responsive">
                    @if (Model.OrderState == OrderState.Created)
                    {
                        @Html.ActionLink("批量生成折扣码", "BatchCreateDiscount", null, new { OrderState = Model.OrderState }, new { @class = "btn btn-primary" })
                    }
                    <table id='order-listing-@Model.OrderState.ToString()' class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th data-searchable="true">单号</th>
                                <th data-searchable="true">国内单号</th>
                                <th>创建时间</th>
                                <th>当前状态</th>
                                <th data-searchable="true">用户</th>
                                <th>备注</th>
                                <th>详情</th>
                                <th>删除</th>
                                <th>打印</th>
                                <th>小单</th>
                                @if (Model.OrderState == OrderState.PendingReturn)
                                {
                                    <th>退运</th>
                                }
                            </tr>
                        </thead>
                    </table>

                    <div id="@("order-listing-" + Model.OrderState.ToString() + "-goto-page")" style="display: flex; align-items: center; justify-content: flex-end; gap: 8px; margin-top: 8px;">
                        <span>跳转到</span>
                        <input type="number" id="@("order-listing-" + Model.OrderState.ToString() + "-goto-page-input")" class="form-control form-control-sm" min="1" step="1" style="width: 70px;" />
                        <span>页 / 共 <span id="@("order-listing-" + Model.OrderState.ToString() + "-total-pages")">1</span> 页</span>
                        <button id="@("order-listing-" + Model.OrderState.ToString() + "-goto-page-btn")" class="btn btn-sm btn-primary">跳转</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
    {
    <script src="~/vendors/jquery-toast-plugin/jquery.toast.min.js"></script>
    <script>
        $(document).ready(() => {
            const isPendingReturn = @(Model.OrderState == OrderState.PendingReturn ? "true" : "false");
            const orderState = '@Model.OrderState';
            const tableId = 'order-listing-@Model.OrderState.ToString()';
            $(`#${tableId} thead tr`).clone(true).appendTo(`#${tableId} thead`);
            $(`#${tableId} thead tr:eq(1) th`).each(function (i) {
                if (!$(this).data('searchable')) {
                    $(this).html('');
                    return;
                }

                const title = $(this).text();
                $(this).css('padding-left', '0');
                $(this).html('<input type="text" class="form-control form-control-sm" placeholder="搜索 ' + title + '" />');

                $('input', this).on('keyup change',
                    function (event) {
                        if (event.key !== 'Enter') {
                            return;
                        }

                        if (orderTable.column(i).search() !== this.value) {
                            orderTable.column(i).search(this.value).draw();
                        }
                    });
            });

            var dataTableOptions = {
                "processing": true, // for show progress bar
                "serverSide": true, // for process server side
                "filter": true, // this is for disable filter (search box)
                "orderMulti": false, // for disable multiple column at once
                "ordering": false,
                "stateSave": false,
                "lengthChange": false, // for show entries dropdown
                "ajax": {
                    "url": '@Url.Action("LoadData", new {orderState = Model.OrderState})',
                    "type": "POST",
                    "datatype": "json"
                },
                "columnDefs": [
                    { "targets": [0], "visible": false, "searchable": false },
                ],
                "columns": [
                    { "data": "id", "name": "Id", "autoWidth": true },
                    {
                        name: "OrderNumber",
                        "render": (data, type, row) => `<a href='#' onclick=loadOrderDetails(${row.id}); >${row.orderNumber || '暂无'}</a>`
                    },
                    { "data": "domesticNumber", "name": "DomesticNumber", "autoWidth": true },
                    { "data": "dateCreatedDisplay", "name": "dateCreatedDisplay", "autoWidth": true },
                    { "data": "stateText", "name": "stateText", "autoWidth": true },
                    { "data": "creator.name", "name": "Creator", "autoWidth": true },
                    {
                        "name": "Memo",
                        "autoWidth": true,
                        "render": (data, type, full, meta) => {
                            return full.memo != null ? '<i class="fa fa-check fa-lg" style="color: green"></i>' : '<i class="fa fa-times fa-lg" style="color: #fc0324de"></i>';
                        }
                    },
                    { "render": (data, type, full, meta) => `<a href='@Url.Action("Edit")?id=${full.id}'><i class="fa fa-edit fa-lg"></i></a>` },
                    { "render": (data, type, full, meta) => `<a href='@Url.Action("Delete")?id=${full.id}&orderState=${orderState}'><i class="fa fa-trash-o fa-lg" style="color: red"></i></a>` },
                    { "render": (data, type, full, meta) => `<a href='@Url.Action("PrintBarcode")?id=${full.id}' target="_blank"><i class="fa fa-print fa-lg"></i></a>` },
                    { "render": (data, type, full, meta) => `<a href='@Url.Action("PrintSmallBarcode")?id=${full.id}' target="_blank"><i class="fa fa-plane fa-lg"></i></a>` },
                ],
                "language": {
                    // https://datatables.net/manual/i18n
                    "processing": "处理中...",
                    search: "_INPUT_",
                    searchPlaceholder: "搜索...",
                    "info": "显示 _TOTAL_ 里面的_START_ 到 _END_",
                    "paginate": {
                        "previous": "前一页",
                        "next": "下一页"
                    },
                },
            };

            if (isPendingReturn) {
                dataTableOptions.columns.push({ "render": (data, type, full, meta) => `<a href='@Url.Action("ReturnComplete")?id=${full.id}&orderState=${orderState}'><i class="fa fa-trailer fa-lg"></i></a>` });
            }

            dataTableOptions.drawCallback = function() {
                const pageInfo = orderTable.page.info();
                const totalPages = pageInfo.pages || 1;
                $(`#${tableId}-total-pages`).text(totalPages);
                $(`#${tableId}-goto-page-input`).attr('max', totalPages);
                $(`#${tableId}-goto-page-input`).val(pageInfo.page + 1);
            };

            const orderTable = $(`#${tableId}`).DataTable(dataTableOptions);
            $("input[type='search']").closest('div.row').hide();

            function goToOrderListingPage() {
                const pageInfo = orderTable.page.info();
                const totalPages = pageInfo.pages || 1;
                const input = $(`#${tableId}-goto-page-input`);
                const requestedPage = parseInt(input.val(), 10);

                if (!requestedPage || requestedPage < 1 || requestedPage > totalPages) {
                    $.toast({
                        heading: 'Danger',
                        text: `请输入 1 到 ${totalPages} 之间的页码`,
                        showHideTransition: 'slide',
                        icon: 'error',
                        loaderBg: '#f2a654',
                        position: 'mid-center',
                        hideAfter: 2000,
                    });
                    input.val(pageInfo.page + 1);
                    return;
                }

                orderTable.page(requestedPage - 1).draw('page');
            }

            $(`#${tableId}-goto-page-btn`).click(function() {
                goToOrderListingPage();
            });

            $(`#${tableId}-goto-page-input`).on('keyup', function(event) {
                if (event.key === 'Enter') {
                    goToOrderListingPage();
                }
            });
        });

        function loadOrderDetails(orderId) {
            $.ajax({
                url: '@Url.Action("QuickView", "Order")',
                data: { id: orderId },
                success: data => $('#order-details').html(data)
            });
        }
    </script>
}