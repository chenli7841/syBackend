@model WebUI.Models.ViewModels.OrderDetailEditModel

<div class="row">
  <div class="col-md-6">
    <div class="form-group row">
      @Html.LabelFor(r => r.ItemCost, "运费", new { @class = "col-sm-4 col-form-label" })
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.ItemCost, "{0:0.00}", new { @class = "form-control", @readonly = "readonly"})
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="form-group row">
      <label class="col-sm-4 col-form-label">总重量</label>
      <div class="col-sm-8">
        <p id="totalWeight">@(Model.BaggageEditModels.Sum(b => b.WeightKg).ToString("0.00"))</p>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="form-group row">
      <label class="col-sm-4 col-form-label">保险</label>
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.InsuranceCost, new { @class = "form-control", @readonly = "readonly" })
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="form-group row">
      <label class="col-sm-4 col-form-label">总体积</label>
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.TotalVolume, new { @class = "form-control", @readonly = "readonly" })
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="form-group row">
      @Html.LabelFor(r => r.Duty, "实收关税", new { @class = "col-sm-4 col-form-label" })
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.Duty, "{0:0.00}", new { @class = "form-control", type = "number", step = "0.01" })
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="form-group row">
      @Html.LabelFor(r => r.WeightKg, "收费重量(kg)", new { @class = "col-sm-4 col-form-label" })
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.WeightKg, "{0:0.00}", new { @class = "form-control", type = "number", step="0.01" })
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="form-group row">
      @Html.LabelFor(r => r.OversizeCost, "超长费用", new { @class = "col-sm-4 col-form-label" })
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.OversizeCost, "{0:0.00}", new { @class = "form-control", type = "number", step = "0.01" })
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="form-group row">
      <label class="col-sm-4 col-form-label">箱数</label>
      <div class="col-sm-8">
        <p id="totalBaggage">@(Model.BaggageEditModels.Count)</p>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="form-group row">
      @Html.LabelFor(r => r.FumigationCost, "熏蒸费用", new { @class = "col-sm-4 col-form-label" })
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.FumigationCost, "{0:0.00}", new { @class = "form-control", type = "number", step = "0.01" })
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="form-group row">
      @Html.LabelFor(r => r.Insurance, "保险金额", new { @class = "col-sm-4 col-form-label" })
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.Insurance, "{0:0.00}", new { @class = "form-control", type = "number", step = "0.01" })
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="form-group row">
      @Html.LabelFor(r => r.WarehouseCost, "仓库费用", new { @class = "col-sm-4 col-form-label" })
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.WarehouseCost, "{0:0.00}", new { @class = "form-control", type = "number", step = "0.01" })
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="form-group row">
      <label class="col-sm-4 col-form-label">用户等级</label>
      <div class="col-sm-8">
        <p>@Model.Creator.Level</p>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="form-group row">
      @Html.LabelFor(r => r.PortMisCost, "港杂费", new { @class = "col-sm-4 col-form-label" })
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.PortMisCost, "{0:0.00}", new { @class = "form-control", type = "number", step = "0.01" })
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="form-group row">
      <label class="col-sm-4 col-form-label">用户余额</label>
      <div class="col-sm-8">
        <p>@Model.Creator.Balance.ToString("0.00")</p>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="form-group row">
      @Html.LabelFor(r => r.Discount, "折扣", new { @class = "col-sm-4 col-form-label" })
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.Discount, "{0:0.00}", new { @class = "form-control", type = "number", step = "0.01" })
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="form-group row">
      <label class="col-sm-4 col-form-label">用户信用</label>
      <div class="col-sm-8">
        <p>@Model.Creator.Credit.ToString("0.00")</p>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="form-group row">
      @Html.LabelFor(r => r.DistrictAdditionalCost, "地区附加费", new { @class = "col-sm-4 col-form-label" })
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.DistrictAdditionalCost, "{0:0.00}", new { @class = "form-control", @readonly = "readonly" })
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="form-group row">
      @Html.LabelFor(r => r.PickUpLocation.DistrictAdditionalCost, "地区附加费率", new { @class = "col-sm-4 col-form-label" })
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.PickUpLocation.DistrictAdditionalCost, "{0:0.00}", new { @class = "form-control", @readonly = "readonly" })
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="form-group row">
      @Html.LabelFor(r => r.ShippingCost, "总费用", new { @class = "col-sm-4 col-form-label" })
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.ShippingCost, "{0:0.00}", new { @class = "form-control", @readonly = "readonly" })
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="form-group row">
      @Html.LabelFor(r => r.StorageCost, "仓储费", new { @class = "col-sm-4 col-form-label" })
      <div class="col-sm-8">
        @Html.TextBoxFor(r => r.StorageCost, "{0:0.00}", new { @class = "form-control", @readonly = "readonly" })
      </div>
    </div>
  </div>
</div>