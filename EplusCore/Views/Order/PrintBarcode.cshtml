@model Domain.Entities.OrderEntity
@using System

@{
    Layout = null;
    ViewBag.Title = "Barcode";

    // 客户号字号在服务端按字符数直接算好，不依赖 JS 量尺寸/收缩。
    var customerCode = Model.Creator?.Code ?? "";
    var cellWidthPx = 540.0;
    var estCharWidthRatio = 0.62;
    var fontSizeByWidth = customerCode.Length > 0 ? cellWidthPx / (customerCode.Length * estCharWidthRatio) : 60.0;
    var customerCodeFontSize = Math.Max(20.0, Math.Min(fontSizeByWidth, 60.0));
}

<!DOCTYPE html>
<html>
<head>
    <title></title>
    <meta charset="utf-8">
    <meta http-equiv="pragma" content="no-cache">
    <meta http-equiv="cache-control" content="no-cache">
    <meta http-equiv="expires" content="0">
    <meta http-equiv="description" content="">
    <style type="text/css">
        @@page {
            size: 150mm 100mm;
            margin: 0;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 150mm;
            height: 100mm;
            font-family: "微软雅黑";
        }

        body {
            box-sizing: border-box;
            padding-top: 2mm;
            padding-bottom: 2mm;
        }

        .row {
            box-sizing: border-box;
            width: 150mm;
            border: 1px solid #000;
            padding: 1mm 2mm;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        #row-barcode1, #row-barcode2 {
            height: 19mm;
        }

        #row-customer {
            height: 19mm;
        }

        #customer-code-text {
            font-weight: bold;
            white-space: nowrap;
        }

        #row-route {
            height: 14mm;
        }

        #row-route > div {
            flex: 1;
            min-width: 0;
            overflow: hidden;
            font-size: 20px;
        }

        #row-address {
            height: 14mm;
            flex-direction: column;
            font-size: 14px;
            line-height: 1.4;
        }

        #row-time {
            height: 6mm;
            font-size: 11px;
        }

        .barcode-wrap {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <!-- 第一行：运单号条形码，左右拉伸铺满 -->
    <div class="row" id="row-barcode1">
        <div class="barcode-wrap">
            <div class="barcode" data-barcode="@Model.OrderNumber"></div>
        </div>
    </div>

    <!-- 第二行：客户号，加粗 -->
    <div class="row" id="row-customer">
        <div id="customer-code-text" style="font-size: @(customerCodeFontSize.ToString("0"))px;">@customerCode</div>
    </div>

    <!-- 第三行：线路 / 取货点名称，字体缩小 -->
    <div class="row" id="row-route">
        <div>@Model.Route?.Code</div>
        <div>@Model.PickUpLocation?.Name</div>
    </div>

    <!-- 第四行：地址，字体缩小 -->
    <div class="row" id="row-address">
        <div>@Model.Creator.ShippingAddress?.DetailArea</div>
        <div>@Model.Creator.ShippingAddress?.City @Model.Creator.ShippingAddress?.Province @Model.Creator.ShippingAddress?.PostalCode</div>
        <div>@Model.Creator.Name @Model.Creator.ShippingAddress?.Mobile</div>
    </div>

    <!-- 第五行：创建时间，字体再缩小 -->
    <div class="row" id="row-time">
        创建时间: @Model.DateCreated.ToString("yyyy-MM-dd HH:mm")
    </div>

    <!-- 第六行：国内单号条形码，左右拉伸铺满 -->
    <div class="row" id="row-barcode2">
        <div class="barcode-wrap">
            <div class="barcode" data-barcode="@Model.DomesticNumber"></div>
        </div>
    </div>

    <script src="~/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/vendors/jquery-barcode/jquery-barcode.min.js"></script>
    <script>
        $(document).ready(function () {
            var barcodes = $('.barcode');
            var targetWidthMm = 145;
            var targetWidthPx = targetWidthMm * 96 / 25.4;
            for (i = 0, il = barcodes.length; i < il; i++) {
                var barcode = $(barcodes[i]);
                barcode.barcode(barcode.data('barcode') + '', 'code128', { barWidth: 1, barHeight: 60 });

                // 拉伸条形码，左右铺满
                var naturalWidth = barcode.width();
                if (naturalWidth > 0) {
                    var scale = targetWidthPx / naturalWidth;
                    barcode.css({
                        'transform': 'scaleX(' + scale + ')',
                        'transform-origin': 'center center'
                    });
                }
            }
        });
    </script>
</body>
</html>
