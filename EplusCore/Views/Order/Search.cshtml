@using Domain.Enums
@model WebUI.Models.ViewModels.OrderSearchViewModel

@{
    ViewData["Title"] = "运单管理";
}

@section Styles
{
    <style>
        div.card .order-card-body, #order-details {
        padding-top: 1rem;
        padding-bottom: 1rem;
        }

        #order-listing_wrapper div#order-listing_filter {
        display: none;
        }

        #order-listing_wrapper div#order-listing_filter input {
        width: 600px;
        }
    </style>
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="card">
            <div class="card-body order-card-body">
                <div style="display: flex; align-items: center; gap: 40px;">
                    <h4 class="card-title" style="margin: 0; flex: none;">搜索</h4>
                    @Html.ActionLink("创建运单", "Create", null, new { OrderState = OrderState.Created }, new { @class = "btn btn-primary", @style = "flex: none;" })
                    <select class="form-control" id="company-select">
                        @{
                            var companies = Model.Companies.ToList();
                            for (int i = 0; i < companies.Count; i++)
                            {
                                var c = companies[i];
                                <option value="@c.Id">@c.Name</option>
                                if (i == companies.Count - 1)
                                {
                                    var allCompanyIds = string.Join(",", companies.Select(c => c.Id));
                                    <option value="@allCompanyIds">All</option>
                                }
                            }
                        }
                        
                    </select>
                </div>
                <div class="table-responsive">
                    <table id='order-listing-search' class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th data-searchable="true">单号</th>
                                <th data-searchable="true">国内单号</th>
                                <th>创建时间</th>
                                <th data-searchable="true">所属船号/航空号</th>
                                <th data-searchable="state">当前状态</th>
                                <th data-searchable="true">用户</th>
                                <th>详情</th>
                                <th>删除</th>
                                <th>打印</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(document).ready(() => {
            let companyIds = '';
            let search = document.location.search;
            if (search.includes("?")) {
                search = search.replace("?", "");
                let part = search.split("&").find(p => p.split("=")[0].toLowerCase() === "companyids");
                companyIds = part.split("=")[1];
            }
            const tableId = 'order-listing-search';
            $(`#${tableId} thead tr`).clone(true).appendTo(`#${tableId} thead`);
            $(`#${tableId} thead tr:eq(1) th`).each(function(i) {
                if (!$(this).data('searchable')) {
                    $(this).html('');
                    return;
                }

                if ($(this).data('searchable') === 'state')
                {
                    $(this).css('padding-left', '0');
                    let allStateOption = "@Html.Raw(string.Join("", Model.AllOrderStates.Select(s => $"<option value='{s.Id}'>{s.Name}</option>")))";
                    $(this).html(`<select class="form-control" id="state-select">${allStateOption}</select>`);
                    $('#state-select').on('change',
                        function(event) {
                            if (orderTable.column(i).search() !== this.value) {
                                orderTable.column(i).search(this.value).draw();
                            }
                        });
                }
                else
                {
                    const title = $(this).text();
                    $(this).css('padding-left', '0');
                    $(this).html('<input type="text" class="form-control form-control-sm" placeholder="搜索 ' + title + '" />');

                    $('input', this).on('keyup change',
                        function(event) {
                            if (event.key !== 'Enter') {
                                return;
                            }

                            if (orderTable.column(i).search() !== this.value) {
                                orderTable.column(i).search(this.value).draw();
                            }
                        });
                }
            });

            var getDataTableOptions = (companyIds) => ({
                "processing": true, // for show progress bar
                "serverSide": true, // for process server side
                "filter": true, // this is for disable filter (search box)
                "orderMulti": false, // for disable multiple column at once
                "ordering": false,
                "stateSave": false,
                "lengthChange": false, // for show entries dropdown
                "ajax": {
                    "url": `@Url.Action("LoadData")?companyIds=${companyIds}`,
                    "type": "POST",
                    "datatype": "json",
                },
                "columnDefs": [
                    { "targets": [0], "visible": false, "searchable": false },
                ],
                "columns": [
                    { "data": "id", "name": "Id", "autoWidth": true },
                    { "data": "orderNumber", "name": "OrderNumber", "autoWidth": true },
                    { "data": "domesticNumber", "name": "DomesticNumber", "autoWidth": true },
                    { "data": "dateCreatedDisplay", "name": "dateCreatedDisplay", "autoWidth": true },
                    { "data": "cargoNumber", "name": "CargoNumber", "autoWidth": true },
                    { "data": "stateText", "name": "stateText", "autoWidth": true },
                    { "data": "creator.name", "name": "Creator", "autoWidth": true },
                    { "render": (data, type, full, meta) => `<a href='@Url.Action("Edit")?id=${full.id}'><i class="fa fa-edit fa-lg"></i></a>` },
                    { "render": (data, type, full, meta) => `<a href='@Url.Action("Delete")?id=${full.id}'><i class="fa fa-trash-o fa-lg" style="color: red"></i></a>` },
                    { "render": (data, type, full, meta) => `<a href='@Url.Action("PrintBarcode")?id=${full.id}' target="_blank"><i class="fa fa-print fa-lg"></i></a>` },
                ],
                "language": {
                    // https://datatables.net/manual/i18n
                    "processing": "处理中...",
                    search: "_INPUT_",
                    searchPlaceholder: "搜索...",
                    "info": "显示 _TOTAL_ 里面的_START_ 到 _END_",
                    "paginate": {
                        "previous": "前一页",
                        "next": "下一页"
                    },
                },
            });
            let orderTable = $(`#${tableId}`).DataTable(getDataTableOptions(companyIds));
            $("input[type='search']").closest('div.row').hide();
            $('#company-select').val(companyIds);
            $('#company-select').change(function () {
                document.location = `${document.location.origin}${document.location.pathname}?companyIds=${$('#company-select').val()}`;
            });
        });
    </script>
}