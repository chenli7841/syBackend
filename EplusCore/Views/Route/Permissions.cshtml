@model Domain.Models.RoutePermissions

@{
    ViewData["Title"] = "线路权限";
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="card">
            <div class="card-body order-card-body">
                <h4 class="card-title">@Model.Name 权限</h4>
                <div class="table-responsive">
                    <table id="user-listing" class="table table-striped">
                        <thead>
                            <tr>
                                <th>代码</th>
                                <th>全选</th>
                                <th>代码</th>
                                <th>全选</th>
                                <th>代码</th>
                                <th>全选</th>
                                <th>代码</th>
                                <th>全选</th>
                            </tr>
                        </thead>
                        <tbody>

                            @for (var i = 0; i < Model.UserPermissions.Count / 4 + 1; i++)
                            {
                            <tr>
                                @for (var j = i * 4; j < Model.UserPermissions.Count && j < (i * 4 + 4); j++)
                                {
                                    <td>@Model.UserPermissions[j].UserCode</td>
                                    @if (Model.UserPermissions[j].IsVisible)
                                    {
                                        <td><input type="checkbox" data-userid="@Model.UserPermissions[j].UserId" checked /></td>
                                    }
                                    else
                                    {

                                        <td><input type="checkbox" data-userid="@Model.UserPermissions[j].UserId" /></td>
                                    }
                                }
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
    {
    <script>
        $(document).ready(() => {
            const routeId = @Model.Id;
            $('input[type="checkbox"]').change(function () {
                const userId = $(this).data('userid');
                const isVisible = this.checked;
                $.post('@Url.Action("SetRouteVisibility", "User")',
                    {
                        userId, routeId, isVisible
                    });
            });
        });
    </script>
}
