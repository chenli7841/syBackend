@model WebUI.Models.ViewModels.BatchViewModel

@if (Model != null)
{
    <h4 class="card-title">批次详细</h4>
    <div class="accordion basic-accordion" id="accordion" role="tablist">
        <div class="card">
            <div class="card-header" role="tab" id="headingOne">
                <h6 class="mb-0">
                    <a data-toggle="collapse" href="#collapseOne" aria-expanded="false" aria-controls="collapseOne" class="collapsed">
                        <i class="card-icon mdi mdi-note-plus-outline"></i>批次 @Model.Name 详情
                    </a>
                </h6>
            </div>
            <div id="collapseOne" class="collapse" role="tabpanel" aria-labelledby="headingOne" data-parent="#accordion" style="">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">名称</label>
                                <div class="col-sm-6 col-form-label">
                                    @Model.Name
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">国际运单号</label>
                                <div class="col-sm-6 col-form-label">
                                    @Model.IntNumber
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">国际转运公司</label>
                                <div class="col-sm-6 col-form-label">
                                    @Model.IntCarrier
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">成本</label>
                                <div class="col-sm-6 col-form-label">
                                    @Model.Cost.ToString("0.00")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">装车发货归属</label>
                                <div class="col-sm-6 col-form-label">
                                    @Model.MasterBatch?.Name
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">步骤归属</label>
                                <div class="col-sm-6 col-form-label">
                                    ??
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">归属客户</label>
                                <div class="col-sm-6 col-form-label">
                                    @Model.Recipient?.Name
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">代理归属</label>
                                <div class="col-sm-6 col-form-label">
                                    @Model.Agent?.Name
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">线路归属</label>
                                <div class="col-sm-6 col-form-label">
                                    @Model.MasterBatch?.Progress?.Route?.Name
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">客户归属错误</label>
                                <div class="col-sm-6 col-form-label">
                                    @Model.RecipientMismatchCount / @Model.TotalOrders
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">代理归属错误</label>
                                <div class="col-sm-6 col-form-label">
                                  @Model.AgentMismatchCount / @Model.TotalOrders
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">线路错误</label>
                                <div class="col-sm-6 col-form-label">
                                    TODO
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">总单数</label>
                                <div class="col-sm-6 col-form-label">
                                    @Model.TotalOrders
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">无重量单数</label>
                                <div class="col-sm-6 col-form-label">
                                    @Model.Orders.Count(o => o.WeightKg < (decimal) 0.01)
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">无入库包裹数</label>
                                <div class="col-sm-6 col-form-label">
                                    TODO
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">无出库</label>
                                <div class="col-sm-6 col-form-label">
                                    TODO
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">无批次</label>
                                <div class="col-sm-6 col-form-label">
                                    TODO
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group row">
                                <label class="col-sm-6 col-form-label">无归属</label>
                                <div class="col-sm-6 col-form-label">
                                    TODO
                                </div>
                            </div>
                        </div>
                    </div>
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group row">
                            <label class="col-sm-6 col-form-label">直邮附加费</label>
                            <div class="col-sm-6 col-form-label">
                                @Model.AddOnCost.ToString("0.00")
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group row">
                            <label class="col-sm-6 col-form-label">关税</label>
                            <div class="col-sm-6 col-form-label">
                                @Model.Duty.ToString("0.00")
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group row">
                            <label class="col-sm-6 col-form-label">仓库附加费</label>
                            <div class="col-sm-6 col-form-label">
                                @Model.StorageCost.ToString("0.00")
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group row">
                            <label class="col-sm-6 col-form-label">和包运费</label>
                            <div class="col-sm-6 col-form-label">
                                @Model.HeBaoCost.ToString("0.00")
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group row">
                            <label class="col-sm-6 col-form-label">保险</label>
                            <div class="col-sm-6 col-form-label">
                                @Model.InsuranceFee.ToString("0.00")
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group row">
                            <label class="col-sm-6 col-form-label">收费重量</label>
                            <div class="col-sm-6 col-form-label">
                                @Model.WeightKg.ToString("0.00")
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group row">
                            <label class="col-sm-6 col-form-label">收费运费</label>
                            <div class="col-sm-6 col-form-label">
                                @Model.TotalExpense.ToString("0.00")
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <h4 class="card-title">请选择批次</h4>
}