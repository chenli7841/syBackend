@model WebUI.Models.ViewModels.OrderDetailViewModel

@if (Model != null)
{
    <h4 class="card-title">运单详细</h4>
    <div class="accordion basic-accordion" id="accordion" role="tablist">
        <div class="card">
            <div class="card-header" role="tab" id="headingOne">
                <h6 class="mb-0">
                    <a data-toggle="collapse" href="#collapseOne" aria-expanded="false" aria-controls="collapseOne" class="collapsed">
                        <i class="card-icon mdi mdi-note-plus-outline"></i>运单号 @Model.OrderNumber 国内单号 @Model.DomesticNumber 国际单号 @Model.SecondTrackNumber
                    </a>
                </h6>
            </div>
            <div id="collapseOne" class="collapse" role="tabpanel" aria-labelledby="headingOne" data-parent="#accordion" style="">
                <div class="card-body">
                    <form class="form-sample">
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DateCreated, "入库时间", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        TODO
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DateDelivered, "发货批次", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        TODO
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DateInWarehouse, "包裹归属", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        TODO
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DeliveryBatch, "客户等级", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        @Model.Creator.Level
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DeliveryBatch, "客户归属", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        @Model.Creator.Name @Model.Creator.Code
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DeliveryBatch, "代理归属", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        @Model.Creator.BelongsTo.Name
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DateCreated, "体积重", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        @Model.VolumeWeight.ToString("0.00")
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DateDelivered, "实重", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        @Model.TotalBaggageWeight.ToString("0.00")
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DateInWarehouse, "收费重量", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        @Model.WeightKg.ToString("0.00")
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DeliveryBatch, "关税", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        @Model.Duty.ToString("0.00")
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DeliveryBatch, "保险", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        @Model.InsuranceClaim.ToString("0.00")
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DeliveryBatch, "折扣", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        @Model.Discount.ToString("0.00")
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DateCreated, "仓库备注", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        @Model.WarehouseNotes
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DateDelivered, "客户备注", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        @Model.Memo
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group row">
                                    @Html.LabelFor(m => m.DateInWarehouse, "运费", new { @class = "col-sm-6 col-form-label" })
                                    <div class="col-sm-6 col-form-label">
                                        @Model.ShippingCost.ToString("0.00")
                                    </div>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <h4 class="card-title">请选择运单</h4>
}