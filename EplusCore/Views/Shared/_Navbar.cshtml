
@{
    var siteLogoUrl = ViewData["SiteLogoUrl"] as string;
    var defaultLogoDataUri = "data:image/png;base64,";
    var navbarLogoSrc = string.IsNullOrEmpty(siteLogoUrl) ? defaultLogoDataUri : siteLogoUrl;
}
<nav class="navbar default-layout col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
    <div class="text-center navbar-brand-wrapper d-flex align-items-top justify-content-center">
        <a class="navbar-brand brand-logo"  asp-area="" asp-controller="Home" asp-action="Index" style="margin-top: 10px">
            <img src="@navbarLogoSrc" alt="" id="site-logo">
            壹嘉国际
        </a>
        <a class="navbar-brand brand-logo-mini" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="@navbarLogoSrc" alt="logo" id="site-logo-mini" class="is-hidden-mobile g-image" style="width: 40px; margin-left: 0.75rem;">
        </a>
    </div>
    <div class="navbar-menu-wrapper d-flex align-items-center">
        <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
            <span class="mdi mdi-menu"></span>
        </button>

        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">联系我们</a>
            </li>
            <partial name="_LoginPartial" />
        </ul>
        <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
            <span class="mdi mdi-menu"></span>
        </button>
    </div>
</nav>