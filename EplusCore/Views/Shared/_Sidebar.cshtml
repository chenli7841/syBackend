                <i class="menu-icon typcn typcn-mail"></i>
                <span class="menu-title">线路管理</span>
            </a>
        </li>
        <li style="display: none;" class="nav-item">
            <a class="nav-link" asp-area="" asp-controller="DeliverProgress" asp-action="Inventory">
                <i class="menu-icon typcn typcn-mail"></i>
                <span class="menu-title">进度管理</span>
            </a>
        </li>
        @if (@SystemSession.CurrentUser.Role == RoleType.Admin)
        {
            <li class="nav-item" style="display: none;">
                <a class="nav-link" asp-area="" asp-controller="PickUpLocation" asp-action="Inventory">
                    <i class="menu-icon typcn typcn-mail"></i>
                    <span class="menu-title">取货点管理</span>
                </a>
            </li>
        }
        <li class="nav-item" style="display: none;">
            <a class="nav-link" asp-area="" asp-controller="User" asp-action="Transactions">
                <i class="menu-icon typcn typcn-mail"></i>
                <span class="menu-title">余额账单</span>
            </a>
        </li>
        <li class="nav-item" style="display: none;">
            <a class="nav-link" asp-area="" asp-controller="System" asp-action="Index">
                <i class="menu-icon typcn typcn-mail"></i>
                <span class="menu-title">系统设置</span>
            </a>
        </li>
        <li class="nav-item" style="display: none;">
            <a class="nav-link" data-toggle="collapse" href="#dataanalysis-pages" aria-expanded="false" aria-controls="dataanalysis-pages">
                <i class="menu-icon typcn typcn-upload-outline"></i>
                <span class="menu-title">数据分析</span>
                <i class="menu-arrow"></i>
            </a>
            <div class="collapse" id="dataanalysis-pages">
                <ul class="nav flex-column sub-menu">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="DataAnalysis" asp-action="DepositInventory">充值交易</a>
