                <i class="menu-icon typcn typcn-upload-outline"></i>
                <span class="menu-title">批次管理</span>
                <i class="menu-arrow"></i>
            </a>
            <div class="collapse" id="batch-pages">
                <ul class="nav flex-column sub-menu">
                    @foreach (var batchGroupType in Enum.GetValues<BatchGroupType>().Where(g => g != BatchGroupType.None))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Batch" asp-action="Inventory" asp-route-groupType="@batchGroupType">@batchGroupType.GetDescription()</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Batch" asp-action="OtherOrder">其他单</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Batch" asp-action="CouponInventory">优惠券</a>
                    </li>
                </ul>
            </div>
        </li>
        <li style="display: none;" class="nav-item">
            <a class="nav-link" data-toggle="collapse" href="#order-pages" aria-expanded="false" aria-controls="order-pages">
                <i class="menu-icon typcn typcn-upload-outline"></i>
                <span class="menu-title">运单管理</span>
                <i class="menu-arrow"></i>
            </a>
