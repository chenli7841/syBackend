                <span class="menu-title">用户管理</span>
                <i class="menu-arrow"></i>
            </a>
            <div class="collapse" id="user-pages">
                <ul class="nav flex-column sub-menu">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="User" asp-action="Inventory">用户信息</a>
