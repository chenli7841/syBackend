                        <a class="nav-link" asp-area="" asp-controller="Batch" asp-action="PendingPickUpInventory">待提货</a>
                    </li>
                    <li class="nav-item" style="display: none;">
                        <a class="nav-link" asp-area="" asp-controller="Batch" asp-action="PendingDeliveryInventory">待派送订单</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Batch" asp-action="Inventory">已完成</a>
                    </li>
                </ul>
            </div>
