@model WebUI.Models.ViewModels.SystemContactUsViewModel
@using Domain.Entities

@{
    ViewData["Title"] = "系统设置";
}

@section Styles
{
    <link rel="stylesheet" href="~/vendors/jquery-toast-plugin/jquery.toast.min.css">
}

@{
    var companies = ((IEnumerable<CompanyEntity>)ViewBag.Companies).ToList();
}


<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="form-group row">
                    <select class="form-control" id="company-select">
                        @{
                            for (int i = 0; i < companies.Count; i++)
                            {
                                if (i == 0)
                                {
                                    <option value="">请选择公司</option>
                                }
                                var c = companies[i];
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    </select>
                </div>
                <h4 style="display: none;" class="card-title">系统设置</h4>

                @using (Html.BeginForm("SaveContactUs", "System", FormMethod.Post, new { @class = "", id = "system" }))
                {
                    @Html.AntiForgeryToken()
                    <h1 class="h4 mb-3">联系客服</h1>
                    <div class="form-group row mb-3">
                        @Html.LabelFor(r => r.WarehouseAddress, "多伦多总仓地址：", new { @class = "col-sm-4 col-form-label" })
                        <div class="col-sm-8">
                            @Html.TextBoxFor(r => r.WarehouseAddress, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        @Html.LabelFor(r => r.ContactPhone, "仓库联系电话：", new { @class = "col-sm-4 col-form-label" })
                        <div class="col-sm-8">
                            @Html.TextBoxFor(r => r.ContactPhone, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        @Html.LabelFor(r => r.BusinessHours, "营业时间：", new { @class = "col-sm-4 col-form-label" })
                        <div class="col-sm-8">
                            @Html.TextAreaFor(r => r.BusinessHours, new { @class = "form-control", @rows = "3" })
                        </div>
                    </div>
                    <h6 class="h6 mb-3">
                        客服微信图片：
                    </h6>
                    <div class="row mt-4">
                            <div class="col-md-12">
                                <div style="display: flex; gap: 24px; align-items: center;" class="image-uploader mb-3" data-photoid="@nameof(Model.CustomerServiceWeChat)" data-photourl='@(Model.CustomerServiceWeChat)'>                                    
                                    <!-- This is where user selects new image -->
                                    <input type="file" class="cropit-image-input" style="display: none" />
                                    <div>图片:</div>
                                    <button class="btn btn-info select">选择</button>
                                    <button class="btn btn-primary upload">上传</button>
                                    <a class="btn btn-primary view" style="color: white; display: @(string.IsNullOrWhiteSpace(Model.CustomerServiceWeChat) ? "none" : "")" target="_blank" href="@(Model.CustomerServiceWeChat)">打开</a>                                    
                                </div>
                            </div>
                    </div>


                    <div class="row">
                        <div class="col-md-1">
                            <button type="submit" class="btn btn-success mr-2">保存</button>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/vendors/jquery-toast-plugin/jquery.toast.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            let companyIds = '';
            let search = document.location.search;
            if (search.includes("?")) {
                search = search.replace("?", "");
                let part = search.split("&").find(p => p.split("=")[0].toLowerCase() === "companyids");
                if (!part) companyIds = "";
                else companyIds = part.split("=")[1];
            }
            $('#company-select').val(companyIds);
            $('#company-select').change(function () {
                document.location = `${document.location.origin}${document.location.pathname}?companyIds=${$('#company-select').val()}`;
            });

            const uploadPhotoUrl = '@Url.Action("GetSystemImageUploadUrl")'; // '@Url.Action("UploadPhoto")';

            $('.image-uploader .select').click(function() {
                if (isNaN(parseInt(companyIds))) {
                    $.toast({
                        heading: 'Danger',
                        text: "请先选择公司",
                        showHideTransition: 'slide',
                        icon: 'error',
                        loaderBg: '#f2a654',
                        position: 'mid-center'
                    });
                    return false;
                }
                $(this).closest('.image-uploader').find('.cropit-image-input').click();

                return false;
            });

            $('.image-uploader .upload').click(function () {
                if (isNaN(parseInt(companyIds))) {
                    $.toast({
                        heading: 'Danger',
                        text: "请先选择公司",
                        showHideTransition: 'slide',
                        icon: 'error',
                        loaderBg: '#f2a654',
                        position: 'mid-center'
                    });
                    return false;
                }
                const uploader = $(this).closest('.image-uploader');
                let photoData = ''; //uploader.cropit('export');
                const photoId = uploader.data('photoid');
                var myFile = $(this).closest('.image-uploader').find('.cropit-image-input').prop('files')[0];
                let reader = new FileReader();
                reader.addEventListener("load", () => {
                    // convert image file to base64 string
                    photoData = reader.result;
                    $.post(uploadPhotoUrl,
                    {
                        propertyName: "CustomerServiceWeChat",
                        companyId: parseInt(companyIds),
                    },
                    function(result) {
                        if (result.error && result.error.text) {
                            $.toast({
                                heading: 'Danger',
                                text: result.error.text,
                                showHideTransition: 'slide',
                                icon: 'error',
                                loaderBg: '#f2a654',
                                position: 'mid-center'
                            });
                        } else {
                            $.toast({
                                heading: '成功',
                                showHideTransition: 'slide',
                                icon: 'success',
                                loaderBg: '#f2a654',
                                position: 'mid-center'
                            });

                            fetch(result.data, {
                                method: 'PUT',
                                headers: {
                                    'Content-Type': 'png',
                                    'x-ms-blob-type': 'BlockBlob',
                                },
                                body: myFile
                            }).then(() => {
                                document.location.reload();
                            });
                        }
                    });
                }, false);
                reader.readAsDataURL(myFile);
                return false;
            });
        });
    </script>
}