@using Domain.Entities
@model WebUI.Models.ViewModels.SystemViewModel

@{
    ViewData["Title"] = "系统设置";
}

@{
    var companies = ((IEnumerable<CompanyEntity>)ViewBag.Companies).ToList();
}

@section Styles
{
    <link rel="stylesheet" href="~/vendors/jquery-toast-plugin/jquery.toast.min.css">
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">系统设置</h4>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">网站 Logo</label>
                            <div class="col-sm-9">
                                <div class="d-flex align-items-center" style="gap: 15px;">
                                    <img id="logo-preview" src="@Model.Settings.LogoUrl" alt="logo" style="max-height: 50px; max-width: 160px; @(string.IsNullOrEmpty(Model.Settings.LogoUrl) ? "display:none;" : "")" />
                                    <input type="file" id="logo-file-input" class="form-control" accept="image/*" style="max-width: 260px;" />
                                    <button type="button" id="logo-upload-btn" class="btn btn-primary">上传</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @using (Html.BeginForm("Save", "System", FormMethod.Post, new { @class = "", id = "system" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label" for="SchedulePickUpText">预约上门说明</label>
                                <div class="col-sm-9">
                                    <input class="form-control" id="SchedulePickUpText" name="SchedulePickUpText" type="number" value="@Model.Settings.SchedulePickUpText">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="DeliveryInitialCost">首重费用</label>
                                <div class="col-sm-8">
                                    <input class="form-control" id="DeliveryInitialCost" name="DeliveryInitialCost" type="number" value="@Model.Settings.DeliveryInitialCost">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="DeliveryRenewalCost">续重费用</label>
                                <div class="col-sm-8">
                                    <input class="form-control" id="DeliveryRenewalCost" name="DeliveryRenewalCost" type="number" value="@Model.Settings.DeliveryRenewalCost">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="DeliveryDistanceAdditionalCost">距离附加费</label>
                                <div class="col-sm-8">
                                    <input class="form-control" id="DeliveryDistanceAdditionalCost" name="DeliveryDistanceAdditionalCost" type="number" value="@Model.Settings.DeliveryDistanceAdditionalCost">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="DeliveryLargeHandlingCost">大件物品搬运费</label>
                                <div class="col-sm-8">
                                    <input class="form-control" id="DeliveryLargeHandlingCost" name="DeliveryLargeHandlingCost" type="number" value="@Model.Settings.DeliveryLargeHandlingCost">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="DeliveryOversizedHandlingCost">超大件物品搬运费</label>
                                <div class="col-sm-8">
                                    <input class="form-control" id="DeliveryOversizedHandlingCost" name="DeliveryOversizedHandlingCost" type="number" value="@Model.Settings.DeliveryOversizedHandlingCost">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="CostStorageTimeout">仓储超时计算时间</label>
                                <div class="col-sm-8">
                                    <input class="form-control" id="CostStorageTimeout" name="CostStorageTimeout" type="number" value="@Model.Settings.CostStorageTimeout">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="WeChatServiceChat">微信手续费</label>
                                <div class="col-sm-8">
                                    <input class="form-control" id="WeChatServiceChat" name="WeChatServiceChat" type="number" value="@Model.Settings.WeChatServiceChat">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label" for="LockedCompanyId">锁定公司</label>
                                <div class="col-sm-8">
                                    <select class="form-control" id="LockedCompanyId" name="LockedCompanyId">
                                        <option value="">不限制</option>
                                        @foreach (var c in companies)
                                        {
                                            if (Model.Settings.LockedCompanyId.HasValue && Model.Settings.LockedCompanyId.Value == c.Id)
                                            {
                                                <option value="@c.Id" selected="selected">@c.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@c.Id">@c.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-1">
                            <button type="submit" class="btn btn-success mr-2">保存</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/vendors/jquery-toast-plugin/jquery.toast.min.js"></script>
    <script>
        $('#logo-upload-btn').click(function () {
            const fileInput = document.getElementById('logo-file-input');
            const file = fileInput.files[0];
            if (!file) {
                $.toast({
                    heading: 'Warning',
                    text: '请先选择图片文件',
                    showHideTransition: 'slide',
                    icon: 'warning',
                    loaderBg: '#f2a654',
                    position: 'mid-center'
                });
                return;
            }

            const self = $('#logo-upload-btn');
            self.text('上传中');
            self.attr('disabled', true);

            const reader = new FileReader();
            reader.onload = function () {
                $.post('@Url.Action("UploadLogo")', { logoData: reader.result }, function (result) {
                    self.text('上传');
                    self.attr('disabled', false);

                    if (result.error && result.error.text) {
                        $.toast({
                            heading: 'Danger',
                            text: result.error.text,
                            showHideTransition: 'slide',
                            icon: 'error',
                            loaderBg: '#f2a654',
                            position: 'mid-center'
                        });
                        return;
                    }

                    $('#logo-preview').attr('src', result.data).show();
                    fileInput.value = '';
                    $.toast({
                        heading: 'Success',
                        text: 'Logo 上传成功',
                        showHideTransition: 'slide',
                        icon: 'success',
                        loaderBg: '#f2a654',
                        position: 'mid-center',
                        hideAfter: 2000,
                    });
                }).fail(function () {
                    self.text('上传');
                    self.attr('disabled', false);
                    $.toast({
                        heading: 'Danger',
                        text: '上传失败,请重试',
                        showHideTransition: 'slide',
                        icon: 'error',
                        loaderBg: '#f2a654',
                        position: 'mid-center'
                    });
                });
            };
            reader.readAsDataURL(file);
        });
    </script>
}
