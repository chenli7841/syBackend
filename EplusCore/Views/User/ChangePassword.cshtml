@model WebUI.Models.ViewModels.AccountViewModel

@{
    ViewData["Title"] = "修改密码";
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">用户信息</h4>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group row">
                            @Html.LabelFor(r => r.UserCode, "编号", new { @class = "col-sm-3 col-form-label" })
                            <div class="col-sm-9 col-form-label">
                                <p>@Model.UserCode</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group row">
                            @Html.LabelFor(r => r.UserName, "用户名", new { @class = "col-sm-3 col-form-label" })
                            <div class="col-sm-9 col-form-label">
                                <p>@Model.UserName</p>
                            </div>
                        </div>
                    </div>
                </div>

                <h4 class="card-title">修改密码</h4>
                @using (Html.BeginForm("ChangePassword", "User", FormMethod.Post, new { @class = "", id = "user" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.TextBoxFor(r => r.Id, new { hidden = "hidden" })

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group row">
                                @Html.LabelFor(r => r.Password, "密码", new { @class = "col-sm-3 col-form-label" })
                                <div class="col-sm-9">
                                    @Html.PasswordFor(r => r.Password, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        
                    </div>
                    
                    <div class="row">
                        <div class="col-md-1">
                            <button type="submit" class="btn btn-success mr-2">保存</button>
                        </div>
                        <div class="col-md-1">
                            @Html.ActionLink("取消", "Inventory", "User", null, new { @class = "btn btn-secondary" })
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
