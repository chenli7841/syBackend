@using Domain.Entities
@{
    ViewData["Title"] = "用户管理";
}

@section Styles
{
    <link rel="stylesheet" href="~/vendors/jquery-toast-plugin/jquery.toast.min.css">
    <style>
        .iconBtn {
            border: none;
            background-color: transparent;
            color: #007bff;
        }
        .userInventoryBalanceTitleBtn {
            border: none;
            background: transparent;
            color: #6200EE;
            cursor: pointer;
            padding: 0;
            margin: 0;
            font: inherit;
            text-align: left;
        }
        #user-listing th,
        #user-listing td {
            text-align: left;
            vertical-align: middle;
            white-space: nowrap;
        }
    </style>
}

@{
    var pickUpLocations = ((IEnumerable<PickUpLocationEntity>)ViewBag.PickUpLocations).ToList();
    var companies = ((IEnumerable<CompanyEntity>)ViewBag.Companies).ToList();
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="card">
            <div class="card-body order-card-body">
                <div class="table-responsive">


                    <div class="row" style="margin: 0; margin-bottom: 12px; gap: 20px; align-items: center;">
                        @Html.ActionLink("导出", "Export", null, null, new { @class = "btn btn-primary" })
                        <div style="display: flex; gap: 4px; height: 32px; flex: 1;">
                            <select class="form-control" id="company-select">
                                @{
                                    for (int i = 0; i < companies.Count; i++)
                                    {
                                        var c = companies[i];
                                        <option value="@c.Id">@c.Name</option>
                                        if (i == companies.Count - 1)
                                        {
                                            var allCompanyIds = string.Join(",", companies.Select(c => c.Id));
                                            <option value="@allCompanyIds">All</option>
                                        }
                                    }
                                }

                            </select>
                            <select class="form-control" id="pickuplocation-select">
                                @{
                                    for (int i = 0; i < pickUpLocations.Count; i++)
                                    {
                                        var c = pickUpLocations[i];
                                        <option value="@c.Id">@c.Name</option>
                                        if (i == pickUpLocations.Count - 1)
                                        {
                                            var allPickUpLocationIds = string.Join(",", pickUpLocations.Select(c => c.Id));
                                            <option value="@allPickUpLocationIds">All</option>
                                        }
                                    }
                                }

                            </select>
                        </div>
                    </div>




                    

                    <table id="user-listing" class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>姓名</th>
                                <th data-searchable="true">代码</th>
                                <th>权限</th>
                                <th data-searchable="true">电话</th>
                                <th>邮箱</th>
                                <th>微信</th>
                                <th>群主</th>
                                <th>取货点</th>
                                <th><button class='userInventoryBalanceTitleBtn' onclick="initializeBalanceSummaryModal()" data-toggle="modal" data-target="#userBalanceSummaryModal">余额</button></th>
                                <th>账单</th>
                                <th>详情</th>
                                <th>密码</th>
                            </tr>
                        </thead>
                    </table>

                    <div id="user-listing-goto-page" style="display: flex; align-items: center; justify-content: flex-end; gap: 8px; margin-top: 8px;">
                        <span>跳转到</span>
                        <input type="number" id="user-listing-goto-page-input" class="form-control form-control-sm" min="1" step="1" style="width: 70px;" />
                        <span>页 / 共 <span id="user-listing-total-pages">1</span> 页</span>
                        <button id="user-listing-goto-page-btn" class="btn btn-sm btn-primary">跳转</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="user-sms-modal" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title mb-3">请输入短信内容</h4>
            <h4 id="user-sms-recipient" class="card-title mb-3"></h4>
            <textarea id="user-sms-message" name="text" class="mb-3" style='border-color: #ccc; border-radius: 5px; min-height: 150px; min-width: 300px;' oninput='this.style.height = "";this.style.height = this.scrollHeight + "px"'></textarea>
            <div style="text-align: end;">
            <button id="user-sms-cancel-btn" class="btn btn-secondary">取消</button>
            <button id="user-sms-send-btn" disabled style="margin-left: 10px;" class="btn btn-primary">发送</button>
            </div>
        </div>
    </div>
</div>
<div id="user-email-modal" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1;">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title mb-3">请输入邮件内容</h4>
            <h4 id="user-email-recipient" class="card-title mb-3" style="text-transform: none;"></h4>
            <div class="mb-3"><input type="text" id="user-email-subject" placeholder="邮件标题" style='border: 1px #ccc solid; border-radius: 5px; padding: 10px; width: 100%;' /></div>
            <div class="mb-3"><textarea id="user-email-message" placeholder="邮件内容" name="text" class="mb-3" style='border-color: #ccc; border-radius: 5px; min-height: 150px; min-width: 300px; padding: 10px;' oninput='this.style.height = "";this.style.height = this.scrollHeight + "px"'></textarea></div>
            <div style="text-align: end;">
            <button id="user-email-cancel-btn" class="btn btn-secondary">取消</button>
            <button id="user-email-send-btn" disabled style="margin-left: 10px;" class="btn btn-primary">发送</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="userBalanceSummaryModal" tabindex="-1" role="dialog" aria-labelledby="userBalanceSummaryLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="row">
                    <div>普通用户的余额总量为 <span id="totalBalanceSpan"></span> 加元。</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="user-balance-summary-close-btn" class="btn btn-success" data-dismiss="modal">关闭</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/vendors/jquery-toast-plugin/jquery.toast.min.js"></script>
    <script>
        let smsRecipientUserId = -1;
        let emailRecipientUserId = -1;
        let totalBalance = undefined;
        function GetSendEmailButtonHTML(userId, userName, mailbox) {
            if (mailbox) return `<button  style="display: none;" class='iconBtn' onclick='openEmail(${userId}, "${userName}", "${mailbox}")'><i class="fa fa-envelope"></i></button>`;
            else return "";
        }

        $(document).ready(() => {
            let companyIds = '', pickuplocationIds = '';
            let search = document.location.search;
            if (search.includes("?")) {
                search = search.replace("?", "");
                let companyPart = search.split("&").find(p => p.split("=")[0].toLowerCase() === "companyids");
                if (!companyPart) companyIds = "";
                else companyIds = companyPart.split("=")[1];
                let pickuplocationPart = search.split("&").find(p => p.split("=")[0].toLowerCase() === "pickuplocationids");
                if (!pickuplocationPart) pickuplocationIds = "";
                else pickuplocationIds = pickuplocationPart.split("=")[1];
            }
            $('#company-select').val(companyIds);
            $('#company-select').change(function () {
                document.location = `${document.location.origin}${document.location.pathname}?companyIds=${$('#company-select').val()}&pickuplocationIds=${pickuplocationIds}`;
            });
            $('#pickuplocation-select').val(pickuplocationIds);
            $('#pickuplocation-select').change(function() {
                document.location = `${document.location.origin}${document.location.pathname}?companyIds=${companyIds}&pickuplocationIds=${$('#pickuplocation-select').val()}`;
            });

            $('#user-listing thead tr').clone(true).appendTo('#user-listing thead');
            $(`#user-listing thead tr:eq(1) th`).each(function(i) {
                if (!$(this).data('searchable')) {
                    $(this).html('');
                    return;
                }
                const title = $(this).text();
                $(this).css('padding-left', '0');
                $(this).html('<input type="text" class="form-control form-control-sm" placeholder="搜索 ' + title + '" />');

                $('input', this).on('keyup change',
                    function(event) {
                        if (event.key !== 'Enter') {
                            return;
                        }

                        if (usersTable.column(i).search() !== this.value) {
                            usersTable.column(i).search(this.value).draw();
                        }
                    });
            });

            const usersTable = $('#user-listing').DataTable({
                "processing": true, // for show progress bar
                "serverSide": true, // for process server side
                "filter": true, // this is for disable filter (search box)
                "orderMulti": false, // for disable multiple column at once
                "ordering": false,
                "stateSave": false,
                "lengthChange": false, // for show entries dropdown
                "ajax": {
                    "url": '@Html.Raw(Url.Action("LoadUsers", new { companyIds = Model.CompanyIds, pickUpLocationIds = Model.PickUpLocationIds }))',
                    "type": "POST",
                    "datatype": "json"
                },
                "columnDefs": [
                    { "targets": [0], "visible": false, "searchable": false },
                    { "targets": [7], "visible": false, "searchable": false },
                ],
                "columns": [
                    { "data": "id", "name": "Id", "autoWidth": true },
                    { "data": "name", "name": "Name", "autoWidth": true },
                    { "data": "code", "name": "Code", "autoWidth": true },
                    { "data": "roleName", "name": "roleName", "autoWidth": true },
                    { "data": "canadaPhoneNumber", "name": "CanadaPhoneNumber", "render": (data, type, full, meta) => `${full.canadaPhoneNumber} <button style="display: none;" class='iconBtn' onclick='openSMS(${full.id}, "${full.name}", "${full.canadaPhoneNumber}")'><i class="fa fa-whatsapp fa-lg"></i></button>` },
                    { "data": "mailbox", "name": "Mailbox", "render": (data, type, full, meta) => `${full.mailbox ?? "<span style='color: #888'>未设定</span>"} ${GetSendEmailButtonHTML(full.id, full.name, full.mailbox)}` },
                    { "data": "weChat", "name": "weChat", "autoWidth": true },
                    { "data": "belongsToName", "name": "BelongsToName", "autoWidth": true },
                    { "data": "pickUpLocation", "name": "pickUpLocation", "autoWidth": true },
                    { "render": (data, type, full, meta) => `<a href='@Url.Action("BalanceTransfer")?touserid=${full.id}'>${(full.balance ?? 0).toFixed(2)}</a>` },
                    { "render": (data, type, full, meta) => `<a href='@Url.Action("Transactions")?userid=${full.id}'>账单</a>` },
                    { "render": (data, type, full, meta) => `<a href='@Url.Action("Edit")?id=${full.id}'><i class="fa fa-edit fa-lg"></i></a>` },
                    { "render": (data, type, full, meta) => `<a href='@Url.Action("ChangePassword")?id=${full.id}'><i class="fa fa-key fa-lg"></i></a>` },
                ],
                "language": {
                    // https://datatables.net/manual/i18n
                    "processing": "处理中...",
                    search: "_INPUT_",
                    searchPlaceholder: "搜索...",
                    "info": "显示 _TOTAL_ 里面的_START_ 到 _END_",
                    "paginate": {
                        "previous": "前一页",
                        "next": "下一页"
                    },
                },
                "drawCallback": function() {
                    const pageInfo = usersTable.page.info();
                    const totalPages = pageInfo.pages || 1;
                    $('#user-listing-total-pages').text(totalPages);
                    $('#user-listing-goto-page-input').attr('max', totalPages);
                    $('#user-listing-goto-page-input').val(pageInfo.page + 1);
                },
            });

            function goToUserListingPage() {
                const pageInfo = usersTable.page.info();
                const totalPages = pageInfo.pages || 1;
                const input = $('#user-listing-goto-page-input');
                const requestedPage = parseInt(input.val(), 10);

                if (!requestedPage || requestedPage < 1 || requestedPage > totalPages) {
                    $.toast({
                        heading: 'Danger',
                        text: `请输入 1 到 ${totalPages} 之间的页码`,
                        showHideTransition: 'slide',
                        icon: 'error',
                        loaderBg: '#f2a654',
                        position: 'mid-center',
                        hideAfter: 2000,
                    });
                    input.val(pageInfo.page + 1);
                    return;
                }

                usersTable.page(requestedPage - 1).draw('page');
            }

            $('#user-listing-goto-page-btn').click(function() {
                goToUserListingPage();
            });

            $('#user-listing-goto-page-input').on('keyup', function(event) {
                if (event.key === 'Enter') {
                    goToUserListingPage();
                }
            });
            $('#user-sms-send-btn').click(function() {
                $('#user-sms-send-btn').attr('disabled', true);
                const sendCustomSMSUrl = '@Url.Action("SendCustomSMS")';
                const message = $('#user-sms-message').val();
                $.post(sendCustomSMSUrl,
                    {
                        recipientUserId: smsRecipientUserId,
                        message: message,
                    },
                    function(result) {
                        if (result.error && result.error.text) {
                            $.toast({
                                heading: 'Danger',
                                text: result.error.text,
                                showHideTransition: 'slide',
                                icon: 'error',
                                loaderBg: '#f2a654',
                                position: 'mid-center',
                                hideAfter: 2000,
                            });
                        } else {
                            if (result.data) {
                                $.toast({
                                    heading: 'Success',
                                    text: `发送成功`,
                                    showHideTransition: 'slide',
                                    icon: 'success',
                                    loaderBg: '#f2a654',
                                    position: 'mid-center',
                                    hideAfter: 2000,
                                });
                                $('#user-sms-message').val('');
                            }
                        }
                    }
                );
                $('#user-sms-modal').css('display', 'none');
            });

            $('#user-email-send-btn').click(function() {
                $('#user-email-send-btn').attr('disabled', true);
                const sendCustomEmailUrl = '@Url.Action("SendCustomEmail")';
                const message = $('#user-email-message').val();
                const subject= $('#user-email-subject').val();
                $.post(sendCustomEmailUrl,
                    {
                        recipientUserId: emailRecipientUserId,
                        message: message,
                        subject: subject
                    },
                    function(result) {
                        if (result.error && result.error.text) {
                            $.toast({
                                heading: 'Danger',
                                text: result.error.text,
                                showHideTransition: 'slide',
                                icon: 'error',
                                loaderBg: '#f2a654',
                                position: 'mid-center',
                                hideAfter: 2000,
                            });
                        } else {
                            if (result.data) {
                                $.toast({
                                    heading: 'Success',
                                    text: `发送成功`,
                                    showHideTransition: 'slide',
                                    icon: 'success',
                                    loaderBg: '#f2a654',
                                    position: 'mid-center',
                                    hideAfter: 2000,
                                });
                                $('#user-email-message').val('');
                            }
                        }
                    }
                );
                $('#user-email-modal').css('display', 'none');
            });

            $('#user-sms-cancel-btn').click(function() {
                $('#user-sms-modal').css('display', 'none');
            });
            $('#user-email-cancel-btn').click(function() {
                $('#user-email-modal').css('display', 'none');
            });
            $('#user-sms-message').bind('input propertychange', function() {
                if($('#user-sms-message').val().trim() === '') {
                    $('#user-sms-send-btn').attr('disabled', true);
                } else {
                    $('#user-sms-send-btn').attr('disabled', false);
                }
            });
            $('#user-email-message').bind('input propertychange', function() {
                if($('#user-email-message').val().trim() === '' || $('#user-email-subject').val().trim() === '') {
                    $('#user-email-send-btn').attr('disabled', true);
                } else {
                    $('#user-email-send-btn').attr('disabled', false);
                }
            });
            $('#user-email-subject').bind('input propertychange', function() {
                if($('#user-email-message').val().trim() === '' || $('#user-email-subject').val().trim() === '') {
                    $('#user-email-send-btn').attr('disabled', true);
                } else {
                    $('#user-email-send-btn').attr('disabled', false);
                }
            });
        });
        function openSMS(userId, recipientName, recipientPhone) {
            smsRecipientUserId = userId;
            $('#user-email-modal').css('display', 'none');
            $('#user-sms-modal').css('display', 'block');
            const recipientHeading = `Recipient: ${recipientName} (${recipientPhone})`;
            $('#user-sms-recipient').text(recipientHeading);
        }
        function openEmail(userId, recipientName, recipientMailbox) {
            emailRecipientUserId = userId;
            $('#user-sms-modal').css('display', 'none');
            $('#user-email-modal').css('display', 'block');
            const recipientHeading = `To: ${recipientName} <${recipientMailbox}>`;
            $('#user-email-recipient').text(recipientHeading);
        }

        function initializeBalanceSummaryModal()
        {
            if (totalBalance > 0)
            {
                document.getElementById('totalBalanceSpan').innerHTML = totalBalance.toFixed(2);
            }
            else
            {
                $.ajax({
                    url: '@Url.Action("GetBalanceSummary")',
                    success: response => {
                        totalBalance = response.data;
                        document.getElementById('totalBalanceSpan').innerHTML = totalBalance.toFixed(2);
                    }
                });
            }
        }
    </script>
}