@model int

@{
    ViewData["Title"] = "余额账单";
}

@section Styles
{
    <style>
        .even {
            background-color: rgba(0, 0, 0, 0.05) !important;
        }
        .odd {
            background-color: transparent !important;
        }
    </style>
}
<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="card">
            <div class="card-body order-card-body">
                <a href='@Url.Action("ExportBill")?userId=@Model' class = "btn btn-primary">导出</a>
                <div class="table-responsive" style="margin-top: 20px">
                    <table style="width: 100%" id="transaction-listing" class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>日期</th>
                                <th>运单</th>
                                <th style="display: none;">批次</th>
                                <th style="display: none;">收件人</th>
                                <th>金额</th>
                                <th style="display: none;">账单类型</th>
                                <th>支付方式</th>
                                <th>用户</th>
                                <th style="display: none;">群主</th>
                                <th style="display: none;">余额</th>
                                <th style="display: none;">备注</th>
                                <th>实际支付金额</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(document).ready(() => {
            let ajaxUrl = '';
            let query = window.location.search.split('?')[1];
            let params = query.split('&').map(p => p.split('='));
            if (params.findIndex(p => p[0] === 'type' && p[1] === '5') > -1) {
                ajaxUrl = '@Html.Raw(@Url.Action("LoadTransactionsByType", new {userId = Model, type = 5}))';
            } else {
                ajaxUrl = '@Url.Action("LoadTransactions", new {userId = Model})';
            }
            const transactionsTable = $('#transaction-listing').DataTable({
                "processing": true, // for show progress bar
                "serverSide": true, // for process server side
                "filter": false, // this is for disable filter (search box)
                "orderMulti": false, // for disable multiple column at once
                "ordering": false,
                "stateSave": true,
                "lengthChange": true, // for show entries dropdown
                "ajax": {
                    "url": ajaxUrl,
                    "type": "POST",
                    "datatype": "json"
                },
                "columnDefs": [
                    { "targets": [0], "visible": false, "searchable": false },
                ],
                "columns": [
                    { "data": "id", "name": "Id", "autoWidth": true },
                    { "data": "displayDate", "name": "displayDate", "autoWidth": true },
                    { "render": (data, type, full, meta) => full.orderId ? `<a href='@Url.Action("Edit", "Order")?id=${full.orderId}'>${full.orderName}</a>` : '' },
                    //{ "render": (data, type, full, meta) => full.batchId ? `<a href='@Url.Action("Edit", "Batch")?id=${full.batchId}'>${full.batchName}</a>` : '' },
                    //{
                    //    "render": (data, type, full, meta) => (full.order && full.order.creator) ? full.order.creator.name : (full.batch && full.batch.recipient ? full.batch.recipient.name : '')
                    //},
                    { "data": "amount", "name": "amount", "autoWidth": true },
                    //{ "data": "typeDisplayText", "name": "amount", "autoWidth": true },
                    { "data": "method", "name": "method", "autoWidth": true },
                    { "data": "user.name", "name": "user", "autoWidth": true },
                    //{
                    //    "render": (data, type, full, meta) => full.user.belongsTo ? full.user.belongsTo.name : ''
                    //},
                    //{ "data": "currentBalance", "name": "currentBalance", "autoWidth": true },
                    //{ "data": "notes", "name": "notes", "autoWidth": true },
                    { "data": "actualAmount", "name": "actualAmount", "autoWidth": true },
                ],
                "language": {
                    // https://datatables.net/manual/i18n
                    "processing": "处理中...",
                    search: "_INPUT_",
                    searchPlaceholder: "搜索...",
                    "info": "显示 _TOTAL_ 里面的_START_ 到 _END_",
                    "paginate": {
                        "previous": "前一页",
                        "next": "下一页"
                    },
                },
                "fnRowCallback": function(nRow, aData, iDisplayIndex, iDisplayIndexFull) {
                    $(nRow).attr('class', aData.colorIndex % 2 === 1 ? 'odd' : 'even');
                }
            });
        });
    </script>
}