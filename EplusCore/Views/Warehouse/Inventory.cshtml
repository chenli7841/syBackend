@model IEnumerable<Domain.Entities.WarehouseEntity>

@{
    ViewData["Title"] = "仓库管理";
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="card">
            <div class="card-body order-card-body">
                <div class="table-responsive">
                    <table id="warehouse-listing" class="table table-striped">
                        <thead>
                            <tr>
                                <th>名称</th>
                                <th>地址</th>
                                <th>联系人</th>
                                <th>排序</th>
                                <th>删除</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var warehouse in Model)
                            {
                                <tr>
                                    <td>@Html.ActionLink(warehouse.Name, "Edit", new { @id = warehouse.Id }, new { @class = "" })</td>
                                    <td>@warehouse.Location</td>
                                    <td>@warehouse.Contact</td>
                                    <td>@warehouse.DisplaySequence</td>
                                    <td><a href='@Url.Action("Delete")?id=@warehouse.Id'><i class="fa fa-times fa-lg" style="color: #fc0324de"></i></a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
    const createUrl = '@Url.Action("Create")';

    $('#warehouse-listing').DataTable({
      paging: false,
      info: false,
      order: [],
      language: {
        search: "搜索:",
      },
    });

    $('#warehouse-listing').closest('.dataTables_wrapper').find('div.row:first-child > div:first-child')
      .append(`<a class="btn btn-primary ml-2" href="${createUrl}">添加</button>`);
    </script>
}